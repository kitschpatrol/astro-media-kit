---
import { parseHTML } from 'linkedom'
import { fillLabel } from './internal/labels'
import { icons, labels } from './internal/theme'
import { escapeAttributeAmpersands } from './utils/html'
import './internal/carousel/carousel.css'

/**
 * An embedded carousel of the components slotted into it: the lightbox's track,
 * in the page. Each child is a slide, swiped, dragged, or stepped through with
 * the buttons and the arrow keys, with optional dots and the slides' own
 * captions below their media. Give the slides the same `zoom` gallery name to
 * open them together in the lightbox.
 */
export type Props = {
	/**
	 * Show each slide's caption below its media. Captions are hidden otherwise,
	 * and still shown in the lightbox.
	 *
	 * @default false
	 */
	captions?: boolean | undefined
	/**
	 * Astro `class` attribute, used instead of `className` when both are present.
	 */
	class?: string | undefined
	/**
	 * JSX-style class name (passed by MDX, which uses `className` instead of
	 * `class`).
	 */
	className?: string | undefined
	/**
	 * Show a dot per slide below the carousel, which also goes to its slide.
	 *
	 * @default false
	 */
	dots?: boolean | undefined
	/**
	 * Accessible name of the carousel.
	 *
	 * @default 'Carousel', or the integration'
	 */
	label?: string | undefined
}

const {
	captions = false,
	class: classFromAstro,
	className: classFromJsx,
	dots = false,
	label = labels.carousel,
} = Astro.props

// Each element the slot renders is a slide. Scripts and styles the components
// emit alongside their markup stay with the carousel, outside the track
const html = await Astro.slots.render('default')
const { document } = parseHTML(`<html><body>${html}</body></html>`)
escapeAttributeAmpersands(document.body)
const slides: string[] = []
const extras: string[] = []
for (const node of document.body.childNodes) {
	if (node.nodeType !== 1) {
		continue
	}

	const element = node as Element
	if (['link', 'script', 'style', 'template'].includes(element.localName)) {
		extras.push(element.outerHTML)
	} else {
		slides.push(element.outerHTML)
	}
}

const hasNavigation = slides.length > 1
---

<div
	aria-label={label}
	aria-roledescription={labels.carouselRole}
	class:list={['amk-carousel', classFromAstro ?? classFromJsx]}
	data-captions={captions ? '' : undefined}
	role="region"
>
	<div class="amk-carousel-viewport">
		<div class="amk-carousel-track" tabindex="-1">
			{slides.map((slide, index) => (
				<div
					aria-label={fillLabel(labels.slide, { count: slides.length, index: index + 1 })}
					aria-roledescription={labels.slideRole}
					class="amk-carousel-slide"
					role="group"
					set:html={slide}
				/>
			))}
		</div>
		{hasNavigation && (
			<>
				<button
					aria-disabled="true"
					aria-label={labels.previous}
					class="amk-carousel-button amk-carousel-previous"
					type="button"
				>
					<span class="amk-carousel-icon" data-amk-icon="previous" set:html={icons.previous} />
				</button>
				<button
					aria-label={labels.next}
					class="amk-carousel-button amk-carousel-next"
					type="button"
				>
					<span class="amk-carousel-icon" data-amk-icon="next" set:html={icons.next} />
				</button>
			</>
		)}
	</div>
	{dots && hasNavigation && (
		<div class="amk-carousel-dots">
			{slides.map((_slide, index) => (
				<button
					aria-current={index === 0 ? 'true' : undefined}
					aria-label={fillLabel(labels.goToSlide, { index: index + 1 })}
					class="amk-carousel-dot"
					type="button"
				/>
			))}
		</div>
	)}
	<Fragment set:html={extras.join('')} />
</div>

{hasNavigation && <script>
	import './internal/carousel'
</script>}
