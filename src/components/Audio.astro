---
import type { PrefixedProps as PrefixedCaptionProps } from './caption-props-map'
import type { AudioService } from './utils/audio'
import type { OembedInfo } from './utils/oembed'
import { toCaptionProps } from './caption-props-map'
import Caption from './Caption.astro'
import FallbackLink from './internal/FallbackLink.astro'
import InternalOembed from './internal/OEmbed.astro'
import { buildSoundCloudEmbedUrl, resolveAudioSource } from './utils/audio'
import { fetchOEmbed } from './utils/oembed'
import './internal/amk-audio.css'

/**
 * Props for the `<Audio>` component — audio player supporting SoundCloud,
 * oEmbed, and local files.
 */
export type Props = Omit<PrefixedCaptionProps, 'creditMediaTypeFallback'> & {
	/**
	 * Start playback automatically.
	 *
	 * @default false
	 */
	autoPlay?: boolean | undefined
	/** Accessible label for the audio player. */
	label?: string | undefined
	/**
	 * Loop playback.
	 *
	 * @default false
	 */
	loop?: boolean | undefined
	/**
	 * Mute audio.
	 *
	 * @default false
	 */
	muted?: boolean | undefined
	/**
	 * Preload behavior hint.
	 *
	 * @default 'metadata'
	 */
	preload?: 'auto' | 'metadata' | 'none' | undefined
	/** Audio service override. Inferred from `src` when omitted. */
	service?: AudioService | undefined
	/** Audio source: a URL, SoundCloud track ID, or local file path. */
	src: string
}

const {
	autoPlay = false,
	credit,
	creditMediaType,
	creditOrganization,
	// eslint-disable-next-line unicorn/prefer-default-parameters -- untyped MDX callers can pass null, which a destructuring default would not replace
	label,
	loop = false,
	muted = false,
	preload = 'metadata',
	service,
	src,
} = Astro.props

const { identifier, service: resolvedService } = resolveAudioSource(src, service)

const resolvedLabel = label ?? 'Audio'

let oembedInfo: OembedInfo | undefined
let embedUrl = ''
// Where a SoundCloud embed links without JavaScript. A bare track ID has no
// track page short of SoundCloud's API, so it links to the player's own page.
let soundcloudPageUrl = ''
let fetchError: string | undefined

if (resolvedService === 'soundcloud') {
	embedUrl = buildSoundCloudEmbedUrl(identifier, { autoPlay })
	soundcloudPageUrl = identifier.startsWith('http') ? identifier : embedUrl
} else if (resolvedService === 'oembed') {
	try {
		oembedInfo = await fetchOEmbed(identifier)
	} catch (error) {
		fetchError = `[astro-media-kit] Audio oEmbed "${identifier}" failed to load: ${error instanceof Error ? error.message : String(error)}`
		console.error(fetchError)
	}
}

const captionProps = await toCaptionProps(
	{ credit, creditMediaType, creditOrganization },
	{ typeFallback: 'audio' },
)

const audioAttributes: astroHTML.JSX.AudioHTMLAttributes = {
	autoplay: autoPlay || undefined,
	crossorigin: 'anonymous',
	loop: loop || undefined,
	muted: muted || undefined,
	preload,
	src: identifier,
}
---

{resolvedService === 'local' && <script>
	import '@videojs/html/audio/player'
	import '@videojs/html/audio/skin'
</script>}

{fetchError !== undefined && fetchError !== '' ? (
	import.meta.env.DEV && <p style="font-family: monospace; color: red;">{fetchError}</p>
) : (
	<Caption {...captionProps}>
		{resolvedService === 'oembed' ? (
			oembedInfo && (
				<InternalOembed
					href={identifier}
					html={oembedInfo.html}
					linkLabel={`Listen on ${oembedInfo.providerName}`}
					resolvedLabel={resolvedLabel}
					slot="media-component"
				/>
			)
		) : resolvedService === 'local' ? (
			<div aria-label={resolvedLabel} class="amk not-content" role="group" slot="media-component">
				{/* eslint-disable astro/jsx-a11y/media-has-caption -- audio elements don't have captions */}
				<audio-player>
					<audio-skin>
						<audio {...audioAttributes} />
					</audio-skin>
				</audio-player>
				<noscript>
					<audio {...audioAttributes} controls />
				</noscript>
				{/* eslint-enable astro/jsx-a11y/media-has-caption */}
			</div>
		) : (
			<div class="amk not-content" slot="media-component">
				<iframe
					allow="autoplay"
					class="amk-soundcloud"
					height="166"
					src={embedUrl}
					title={resolvedLabel}
				/>
				<FallbackLink href={soundcloudPageUrl} label="Listen on SoundCloud" />
			</div>
		)}
		<slot />
	</Caption>
)}
