---
import type { MediaType } from '../types'

const capitalize = (s: string): string => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase()

// Re-export PrefixedProps so it remains importable from `./Caption.astro`.
// The type itself lives in `./caption-props-map` because astro-eslint-parser
// fails to resolve mapped/derived types imported across `.astro` → `.astro`
// file boundaries.
export type { PrefixedProps } from './caption-props-map'

/**
 * Props for the `<Caption>` component — wraps content in
 * `<figure>`/`<figcaption>` with an optional credit line. `<Image>` and
 * `<Picture>` fill in values they read from the image's XMP tags.
 */
export type Props = {
	/** Attribution name for the media creator. */
	creator?: string | undefined
	/** Organization or publication to credit alongside the creator. */
	organization?: string | undefined
	/**
	 * Show the credit line in the caption.
	 *
	 * @default true
	 */
	showCredit?: boolean | undefined
	/**
	 * Semantic media type label (e.g. `'photo'`, `'screenshot'`), shown
	 * capitalized in the credit line. Any string works, so free-text XMP labels
	 * show as written.
	 */
	type?: MediaType | (string & {}) | undefined
}

const { creator, organization, showCredit = true, type } = Astro.props

// Render the credit nicely

const creditLine =
	creator !== undefined || organization !== undefined
		? [
				type === undefined ? undefined : capitalize(type),
				[creator, organization].filter(Boolean).join(' / '),
			]
				.filter(Boolean)
				.join(': ')
		: undefined

// Can't get rid of children in markdown, so we inspect what's in the slot
const hasCaption = Boolean(
	// eslint-disable-next-line unicorn/no-await-expression-member
	Astro.slots.default && (await Astro.slots.render('default')).trim().length > 0,
)

const hasCredit = showCredit && creditLine !== undefined
---

{hasCaption || hasCredit ? (
	<figure>
		<slot name="media-component" />
		<figcaption>
			{hasCaption && (
				<span class="caption">
					<slot />
				</span>
			)}
			{hasCredit && <span class="credit">{creditLine}</span>}
		</figcaption>
	</figure>
) : (
	<slot name="media-component" />
)}
