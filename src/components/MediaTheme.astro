---
import { parseMediaThemeIcon } from './utils/media-theme'

/**
 * Optional document-wide icon overrides. Put one in the page layout and supply
 * decorative SVGs through `icon-*` slots. Missing icons keep their defaults.
 */
const icons = await Promise.all(
	Object.keys(Astro.slots).map(async (slot) =>
		parseMediaThemeIcon(slot, await Astro.slots.render(slot)),
	),
)
---

<template data-amk-media-theme>
	{icons.map(({ markup, name }) => (
		<template data-amk-icon={name} set:html={markup} />
	))}
</template>

<script>
	import './internal/media-theme'
</script>
