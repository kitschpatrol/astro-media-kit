---
import { normalizeEmbedHtml } from '../utils/oembed'
import FallbackLink from './FallbackLink.astro'
import './amk-oembed.css'

export type Props = {
	/**
	 * The embed's aspect ratio. With one, the embed scales to the column's width
	 * at that ratio; without, it keeps the provider's size within the column.
	 */
	aspectRatio?: string | undefined
	/** Where the media plays without JavaScript, which embeds need. */
	href: string
	html: string
	/** The fallback link's visible text, such as "Watch on TED". */
	linkLabel: string
	/** The fallback link's poster, used only with an aspect ratio to size it. */
	posterUrl?: string | undefined
	resolvedLabel: string
}

const { aspectRatio, href, html, linkLabel, posterUrl, resolvedLabel } = Astro.props
const isScaled = aspectRatio !== undefined && aspectRatio !== ''
const hasPoster = posterUrl !== undefined && posterUrl !== ''

// Provider HTML with a title on its iframes, deprecated attributes removed,
// and attribute names lowercased
const resolvedHtml = normalizeEmbedHtml(html, resolvedLabel)
---

<div
	aria-label={resolvedLabel}
	class="amk amk-oembed not-content"
	data-scaled={isScaled ? '' : undefined}
	role="group"
	style={isScaled ? `aspect-ratio: ${aspectRatio}` : undefined}
>
	<Fragment set:html={resolvedHtml} />
	<FallbackLink
		href={href}
		label={linkLabel}
		poster={isScaled && hasPoster ? { alt: resolvedLabel, src: posterUrl } : undefined}
		style={isScaled ? `width: 100%; aspect-ratio: ${aspectRatio}` : undefined}
	/>
</div>
