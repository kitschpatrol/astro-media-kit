---
import { sanitizeEmbedHtml } from '../utils/oembed'

export type Props = {
	aspectRatio?: string | undefined
	html: string
	resolvedLabel: string
	/**
	 * Sanitize provider HTML: adds missing `title` on iframes, removes deprecated
	 * attributes (`frameborder`, `scrolling`), and lowercases non-standard
	 * attribute names.
	 *
	 * @default true
	 */
	sanitize?: boolean | undefined
}

const { aspectRatio, html, resolvedLabel, sanitize = true } = Astro.props
const style = aspectRatio ? `aspect-ratio: ${aspectRatio}` : undefined

const resolvedHtml = sanitize ? sanitizeEmbedHtml(html, resolvedLabel) : html
---

<div aria-label={resolvedLabel} class="amk not-content" role="group" style={style}>
	<Fragment set:html={resolvedHtml} />
</div>
