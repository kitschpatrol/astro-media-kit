---
import type { InternalVideoProps } from './types'
import Icon from './Icon.astro'

export type Props = {
	controls: InternalVideoProps['controls']
	zoom?: boolean
}

const { controls, zoom = false } = Astro.props
// A minimal player that can zoom gets the full bar as well, hidden on the page
// and shown by the lightbox, which gives the player its own control level
const hasBar = controls === 'full' || controls === 'lightbox' || (controls === 'minimal' && zoom)
const hasFullscreen =
	controls === 'full' || (zoom && (controls === 'minimal' || controls === 'none'))
const uid = `amk-${crypto.randomUUID()}`
---

<media-controls data-interactive="">
	<media-controls-content class="amk-controls">
		{controls === 'minimal' && (
			<media-play-button class="amk-button amk-center-play">
				<Icon class="amk-icon-play" name="play" />
				<Icon class="amk-icon-pause" name="pause" />
				<Icon class="amk-icon-restart" name="restart" />
			</media-play-button>
		)}
		{(hasBar || hasFullscreen) && (
			<media-tooltip-group>
				<media-controls-group aria-label="Playback controls" class="amk-bar">
					{hasBar && (
						<div class="amk-playback">
							<media-play-button class="amk-button" id={`${uid}-play`}>
								<Icon class="amk-icon-play" name="play" />
								<Icon class="amk-icon-pause" name="pause" />
								<Icon class="amk-icon-restart" name="restart" />
							</media-play-button>
							<media-tooltip
								boundary="viewport"
								class="amk-tooltip"
								id={`${uid}-play-tooltip`}
								trigger={`${uid}-play`}
							>
								<media-tooltip-label />
								<media-tooltip-shortcut class="amk-tooltip-shortcut" />
							</media-tooltip>
							<amk-mute-button class="amk-button" commandfor={`${uid}-volume`} id={`${uid}-mute`}>
								<Icon class="amk-icon-volume-off" name="volume-off" />
								<Icon class="amk-icon-volume-low" name="volume-low" />
								<Icon class="amk-icon-volume-high" name="volume-high" />
							</amk-mute-button>
							<media-volume-popover
								boundary="viewport"
								class="amk-volume-popover"
								close-delay="40"
								delay="0"
								id={`${uid}-volume`}
								open-on-hover
								side="top"
							>
								<media-volume-slider class="amk-slider amk-volume-slider" orientation="vertical">
									<media-slider-track class="amk-slider-track">
										<media-slider-fill class="amk-slider-fill" />
									</media-slider-track>
									<media-slider-thumb class="amk-slider-thumb" />
								</media-volume-slider>
							</media-volume-popover>
							<media-time-slider class="amk-slider amk-time-slider">
								<media-slider-track class="amk-slider-track">
									<media-slider-buffer class="amk-slider-buffer" />
									<media-slider-fill class="amk-slider-fill" />
								</media-slider-track>
								<media-slider-thumb class="amk-slider-thumb" />
								<media-slider-value class="amk-slider-value" type="pointer" />
							</media-time-slider>
							<media-time-group class="amk-time">
								<media-time type="current" />
								<media-time-separator />
								<media-time type="duration" />
							</media-time-group>
							<media-captions-button class="amk-button" id={`${uid}-captions`}>
								<Icon class="amk-icon-captions-off" name="captions-off" />
								<Icon class="amk-icon-captions-on" name="captions-on" />
							</media-captions-button>
							<media-tooltip
								boundary="viewport"
								class="amk-tooltip"
								id={`${uid}-captions-tooltip`}
								trigger={`${uid}-captions`}
							>
								<media-tooltip-label />
								<media-tooltip-shortcut class="amk-tooltip-shortcut" />
							</media-tooltip>
						</div>
					)}
					{hasFullscreen &&
						(zoom ? (
							<>
								<button
									aria-haspopup="dialog"
									aria-label="Expand video"
									class="amk-button amk-zoom-button"
									data-zoom-open=""
									id={`${uid}-zoom`}
									type="button"
								>
									<Icon class="amk-icon-zoom-enter" name="expand" />
								</button>
								<media-tooltip
									boundary="viewport"
									class="amk-tooltip amk-zoom-tooltip"
									id={`${uid}-zoom-tooltip`}
									trigger={`${uid}-zoom`}
								>
									Expand
								</media-tooltip>
								<button
									aria-label="Collapse video"
									class="amk-button amk-collapse-button"
									data-zoom-close=""
									id={`${uid}-collapse`}
									type="button"
								>
									<Icon class="amk-icon-zoom-exit" name="collapse" />
								</button>
								<media-tooltip
									boundary="viewport"
									class="amk-tooltip amk-collapse-tooltip"
									id={`${uid}-collapse-tooltip`}
									trigger={`${uid}-collapse`}
								>
									Collapse
								</media-tooltip>
							</>
						) : (
							<>
								<media-fullscreen-button class="amk-button" id={`${uid}-fullscreen`}>
									<Icon class="amk-icon-fullscreen-enter" name="fullscreen-enter" />
									<Icon class="amk-icon-fullscreen-exit" name="fullscreen-exit" />
								</media-fullscreen-button>
								<media-tooltip
									boundary="viewport"
									class="amk-tooltip"
									id={`${uid}-fullscreen-tooltip`}
									trigger={`${uid}-fullscreen`}
								>
									<media-tooltip-label />
									<media-tooltip-shortcut class="amk-tooltip-shortcut" />
								</media-tooltip>
							</>
						))}
				</media-controls-group>
			</media-tooltip-group>
		)}
	</media-controls-content>
</media-controls>
<media-status-announcer class="amk-announcer" />
