---
import type { InternalVideoProps } from './types'

export type Props = {
	controls: InternalVideoProps['controls']
	floating?: boolean
	zoom?: boolean
}

const { controls, floating = false, zoom = false } = Astro.props
// A minimal player that can zoom gets the full bar as well, hidden on the page
// and shown by the lightbox, which gives the player its own control level
const hasBar = controls === 'full' || controls === 'lightbox' || (controls === 'minimal' && zoom)
const hasFullscreen = controls === 'full' || controls === 'minimal'
const uid = `amk-${crypto.randomUUID()}`
---

<media-controls data-interactive="" visibility={floating ? 'always' : undefined}>
	<media-controls-content class="amk-controls">
		{controls === 'minimal' && (
			<media-play-button class="amk-button amk-center-play">
				<media-icon class="amk-icon-play" name="play" />
				<media-icon class="amk-icon-pause" name="pause" />
				<media-icon class="amk-icon-restart" name="restart" />
			</media-play-button>
		)}
		<media-tooltip-group>
			<media-controls-group aria-label="Playback controls" class="amk-bar">
				{hasBar && (
					<div class="amk-playback">
						<media-play-button class="amk-button" id={`${uid}-play`}>
							<media-icon class="amk-icon-play" name="play" />
							<media-icon class="amk-icon-pause" name="pause" />
							<media-icon class="amk-icon-restart" name="restart" />
						</media-play-button>
						<media-tooltip class="amk-tooltip" id={`${uid}-play-tooltip`} trigger={`${uid}-play`}>
							<media-tooltip-label />
							<media-tooltip-shortcut class="amk-tooltip-shortcut" />
						</media-tooltip>
						<media-mute-button class="amk-button" commandfor={`${uid}-volume`} id={`${uid}-mute`}>
							<media-icon class="amk-icon-volume-off" name="volume-off" />
							<media-icon class="amk-icon-volume-low" name="volume-low" />
							<media-icon class="amk-icon-volume-high" name="volume-high" />
						</media-mute-button>
						<media-volume-popover
							class="amk-volume-popover"
							close-delay="100"
							delay="200"
							id={`${uid}-volume`}
							open-on-hover
							side="top"
						>
							<media-volume-slider class="amk-slider amk-volume-slider" orientation="vertical">
								<media-slider-track class="amk-slider-track">
									<media-slider-fill class="amk-slider-fill" />
								</media-slider-track>
								<media-slider-thumb class="amk-slider-thumb" />
							</media-volume-slider>
						</media-volume-popover>
						<media-time-slider class="amk-slider amk-time-slider">
							<media-slider-track class="amk-slider-track">
								<media-slider-buffer class="amk-slider-buffer" />
								<media-slider-fill class="amk-slider-fill" />
							</media-slider-track>
							<media-slider-thumb class="amk-slider-thumb" />
							<media-slider-value class="amk-slider-value" type="pointer" />
						</media-time-slider>
						<media-time-group class="amk-time">
							<media-time type="current" />
							<media-time-separator />
							<media-time type="duration" />
						</media-time-group>
						<media-captions-button class="amk-button" id={`${uid}-captions`}>
							<media-icon class="amk-icon-captions-off" name="captions-off" />
							<media-icon class="amk-icon-captions-on" name="captions-on" />
						</media-captions-button>
						<media-tooltip
							class="amk-tooltip"
							id={`${uid}-captions-tooltip`}
							trigger={`${uid}-captions`}
						>
							<media-tooltip-label />
							<media-tooltip-shortcut class="amk-tooltip-shortcut" />
						</media-tooltip>
					</div>
				)}
				{hasFullscreen &&
					(zoom ? (
						<>
							<button
								aria-label="Expand video"
								class="amk-button amk-zoom-button"
								data-zoom-open=""
								id={`${uid}-zoom`}
								type="button"
							>
								<media-icon class="amk-icon-zoom-enter" name="fullscreen-enter" />
								<media-icon class="amk-icon-zoom-exit" name="fullscreen-exit" />
							</button>
							<media-tooltip class="amk-tooltip" id={`${uid}-zoom-tooltip`} trigger={`${uid}-zoom`}>
								<span class="amk-zoom-enter-label">Expand</span>
								<span class="amk-zoom-exit-label">Close</span>
							</media-tooltip>
						</>
					) : (
						<>
							<media-fullscreen-button class="amk-button" id={`${uid}-fullscreen`}>
								<media-icon class="amk-icon-fullscreen-enter" name="fullscreen-enter" />
								<media-icon class="amk-icon-fullscreen-exit" name="fullscreen-exit" />
							</media-fullscreen-button>
							<media-tooltip
								class="amk-tooltip"
								id={`${uid}-fullscreen-tooltip`}
								trigger={`${uid}-fullscreen`}
							>
								<media-tooltip-label />
								<media-tooltip-shortcut class="amk-tooltip-shortcut" />
							</media-tooltip>
						</>
					))}
			</media-controls-group>
		</media-tooltip-group>
	</media-controls-content>
</media-controls>
<media-status-announcer class="amk-announcer" />
