---
import type { InternalVideoProps, VideoElementTag } from './types'
import { getControllerStyle } from './types'
import VideoControls from './VideoControls.astro'
import VideoError from './VideoError.astro'
import VideoMedia from './VideoMedia.astro'
import './amk-video.css'

export type Props = InternalVideoProps & {
	/** Which media element to render. */
	element: VideoElementTag
	/** Where the error dialog sends the viewer to watch the video directly. */
	fallbackUrl: string
	/** HLS URL for noscript fallback. */
	hlsUrl?: string | undefined
	/** MP4 fallback URL for noscript. */
	mp4Url?: string | undefined
}

const {
	aspectRatio,
	autoPlay,
	captions,
	controls,
	element,
	fallbackUrl,
	hlsOptions,
	hlsUrl,
	intrinsicWidth,
	loop,
	mp4Url,
	muted,
	posterUrl,
	preload,
	resolvedLabel,
	videoSrc,
	zoom,
} = Astro.props

const isHls = element === 'hlsjs-video'
const isNative = controls === 'native'
const hasControls = controls !== 'none' && !isNative
const hasFullscreen = controls === 'full' || controls === 'minimal'
// Click-to-play stays off where a click must do something else: open the
// lightbox (zoom), or nothing at all ('lightbox' mode is for a player that
// should omit its fullscreen control).
const hasClickToPlay = hasFullscreen && !zoom
const hasPoster = posterUrl !== undefined && posterUrl !== ''

const containerStyle = getControllerStyle(intrinsicWidth, aspectRatio)

const mediaAttributes: astroHTML.JSX.VideoHTMLAttributes = {
	autoplay: autoPlay || undefined,
	class: 'amk-media',
	crossorigin: 'anonymous',
	// No picture-in-picture control is offered, so keep the browser's own
	// affordance off the HLS element as before.
	disablepictureinpicture: isHls || undefined,
	loop: loop || undefined,
	muted: muted || undefined,
	playsinline: 'true',
	poster: posterUrl,
	preload,
}

const mediaProps = { attributes: mediaAttributes, captions, element, hlsOptions, src: videoSrc }
---

{!isNative && <script>
	import './videojs-ui'
</script>}

{isNative ? (
	<div aria-label={resolvedLabel} class="amk not-content" role="group">
		<VideoMedia {...mediaProps} native={true} style={containerStyle} />
	</div>
) : (
	<div class="amk not-content">
		<video-player
			class="amk-player"
			data-autoplay={autoPlay ? '' : undefined}
			data-controls={controls}
			poster={posterUrl}
		>
			<media-container
				aria-label={resolvedLabel}
				class="amk-container"
				data-media=""
				style={containerStyle}
				tabindex={controls === 'none' ? '-1' : undefined}
			>
				<VideoMedia {...mediaProps} native={false} />
				<VideoError fallbackUrl={fallbackUrl} />
				{hasPoster && <media-poster class="amk-poster" />}
				<media-buffering-indicator class="amk-buffering">
					<media-icon name="spinner" />
				</media-buffering-indicator>
				{hasControls && <VideoControls controls={controls} zoom={zoom} />}
				{hasControls && (
					<>
						{hasClickToPlay && (
							<media-gesture action="togglePaused" pointer="mouse" region="center" type="tap" />
						)}
						<media-gesture action="toggleControls" pointer="touch" type="tap" />
						<media-hotkey action="togglePaused" keys="Space" />
						<media-hotkey action="togglePaused" keys="k" />
						<media-hotkey action="toggleMuted" keys="m" />
						<media-hotkey action="seekStep" keys="ArrowLeft" />
						<media-hotkey action="seekStep" keys="ArrowRight" />
						<media-hotkey action="seekStep" keys="j" />
						<media-hotkey action="seekStep" keys="l" />
						<media-hotkey action="volumeStep" keys="ArrowUp" />
						<media-hotkey action="volumeStep" keys="ArrowDown" />
						<media-hotkey action="toggleSubtitles" keys="c" />
						{hasFullscreen && !zoom && <media-hotkey action="toggleFullscreen" keys="f" />}
					</>
				)}
			</media-container>
		</video-player>
		{isHls && hlsUrl !== undefined && hlsUrl !== '' && (
			<noscript>
				{/* eslint-disable-next-line astro/jsx-a11y/media-has-caption -- noscript fallback is minimal */}
				<video {...mediaAttributes} controls>
					<source src={hlsUrl} type="application/x-mpegURL" />
					{mp4Url !== undefined && mp4Url !== '' && <source src={mp4Url} type="video/mp4" />}
					Your browser does not support HTML5 video.
				</video>
			</noscript>
		)}
	</div>
)}
