---
import type { InternalVideoProps, VideoElementTag } from './types'
import { getControllerStyle } from './types'
import VideoMedia from './VideoMedia.astro'
import './amk-video.css'

export type Props = InternalVideoProps & {
	/** Which media element to render. */
	element: VideoElementTag
	/** HLS URL for noscript fallback. */
	hlsUrl?: string | undefined
	/** MP4 fallback URL for noscript. */
	mp4Url?: string | undefined
}

const {
	aspectRatio,
	autoPlay,
	captions,
	controls,
	element,
	hlsOptions,
	hlsUrl,
	intrinsicWidth,
	loop,
	mp4Url,
	muted,
	posterUrl,
	preload,
	resolvedLabel,
	videoSrc,
	zoom,
} = Astro.props

const isHls = element === 'hlsjs-video'
const isNative = controls === 'native'
const hasControls = controls !== 'none' && !isNative
const hasBar = controls === 'full' || controls === 'lightbox'
const hasFullscreen = controls === 'full' || controls === 'minimal'
// Click-to-play stays off where a click must do something else: open the
// lightbox (zoom), or nothing at all ('lightbox' mode mirrors the player
// inside PhotoSwipe, where clicks zoom the slide).
const hasClickToPlay = hasFullscreen && !zoom
const hasPoster = posterUrl !== undefined && posterUrl !== ''

const containerStyle = getControllerStyle(intrinsicWidth, aspectRatio)

const mediaAttributes: astroHTML.JSX.VideoHTMLAttributes = {
	autoplay: autoPlay || undefined,
	class: 'amk-media',
	crossorigin: 'anonymous',
	// No picture-in-picture control is offered, so keep the browser's own
	// affordance off the HLS element as before.
	disablepictureinpicture: isHls || undefined,
	loop: loop || undefined,
	muted: muted || undefined,
	playsinline: 'true',
	poster: posterUrl,
	preload,
}

const mediaProps = { attributes: mediaAttributes, captions, element, hlsOptions, src: videoSrc }

// Tooltips are linked to their buttons by id, and each tooltip's own id names
// its CSS anchor, so both must be unique per player on the page.
const uid = `amk-${crypto.randomUUID().slice(0, 8)}`
---

{!isNative && <script>
	import './videojs-ui'
</script>}

{isNative ? (
	<div aria-label={resolvedLabel} class="amk not-content" role="group">
		<VideoMedia {...mediaProps} native={true} style={containerStyle} />
	</div>
) : (
	<div class="amk not-content">
		<video-player
			class="amk-player"
			data-autoplay={autoPlay ? '' : undefined}
			data-controls={controls}
			poster={posterUrl}
		>
			<media-container
				aria-label={resolvedLabel}
				class="amk-container"
				inert={controls === 'none' || undefined}
				style={containerStyle}
			>
				<VideoMedia {...mediaProps} native={false} />
				{hasPoster && <media-poster class="amk-poster" />}
				<media-buffering-indicator class="amk-buffering">
					<media-icon name="spinner" />
				</media-buffering-indicator>
				{hasControls && (
					<media-controls>
						<media-controls-content class="amk-controls">
							{controls === 'minimal' && (
								<media-play-button class="amk-button amk-center-play">
									<media-icon class="amk-icon-play" name="play" />
									<media-icon class="amk-icon-pause" name="pause" />
									<media-icon class="amk-icon-restart" name="restart" />
								</media-play-button>
							)}
							<media-tooltip-group>
								<media-controls-group aria-label="Playback controls" class="amk-bar">
									{hasBar && (
										<>
											<media-play-button class="amk-button" id={`${uid}-play`}>
												<media-icon class="amk-icon-play" name="play" />
												<media-icon class="amk-icon-pause" name="pause" />
												<media-icon class="amk-icon-restart" name="restart" />
											</media-play-button>
											<media-tooltip
												class="amk-tooltip"
												id={`${uid}-play-tooltip`}
												trigger={`${uid}-play`}
											>
												<media-tooltip-label />
												<media-tooltip-shortcut class="amk-tooltip-shortcut" />
											</media-tooltip>
											<media-mute-button class="amk-button" id={`${uid}-mute`}>
												<media-icon class="amk-icon-volume-off" name="volume-off" />
												<media-icon class="amk-icon-volume-low" name="volume-low" />
												<media-icon class="amk-icon-volume-high" name="volume-high" />
											</media-mute-button>
											<media-tooltip
												class="amk-tooltip"
												id={`${uid}-mute-tooltip`}
												trigger={`${uid}-mute`}
											>
												<media-tooltip-label />
												<media-tooltip-shortcut class="amk-tooltip-shortcut" />
											</media-tooltip>
											<media-volume-slider class="amk-slider amk-volume-slider">
												<media-slider-track class="amk-slider-track">
													<media-slider-fill class="amk-slider-fill" />
												</media-slider-track>
												<media-slider-thumb class="amk-slider-thumb" />
											</media-volume-slider>
											<media-time-slider class="amk-slider amk-time-slider">
												<media-slider-track class="amk-slider-track">
													<media-slider-buffer class="amk-slider-buffer" />
													<media-slider-fill class="amk-slider-fill" />
												</media-slider-track>
												<media-slider-thumb class="amk-slider-thumb" />
												<media-slider-value class="amk-slider-value" type="pointer" />
											</media-time-slider>
											<media-time-group class="amk-time">
												<media-time type="current" />
												<media-time-separator />
												<media-time type="duration" />
											</media-time-group>
											<media-captions-button class="amk-button" id={`${uid}-captions`}>
												<media-icon class="amk-icon-captions-off" name="captions-off" />
												<media-icon class="amk-icon-captions-on" name="captions-on" />
											</media-captions-button>
											<media-tooltip
												class="amk-tooltip"
												id={`${uid}-captions-tooltip`}
												trigger={`${uid}-captions`}
											>
												<media-tooltip-label />
												<media-tooltip-shortcut class="amk-tooltip-shortcut" />
											</media-tooltip>
										</>
									)}
									{hasFullscreen &&
										(zoom ? (
											<>
												<button
													aria-label="Zoom"
													class="amk-button amk-zoom-button pswp-video-trigger"
													id={`${uid}-zoom`}
													type="button"
												>
													<media-icon name="fullscreen-enter" />
												</button>
												<media-tooltip
													class="amk-tooltip"
													id={`${uid}-zoom-tooltip`}
													trigger={`${uid}-zoom`}
												>
													Zoom
												</media-tooltip>
											</>
										) : (
											<>
												<media-fullscreen-button class="amk-button" id={`${uid}-fullscreen`}>
													<media-icon class="amk-icon-fullscreen-enter" name="fullscreen-enter" />
													<media-icon class="amk-icon-fullscreen-exit" name="fullscreen-exit" />
												</media-fullscreen-button>
												<media-tooltip
													class="amk-tooltip"
													id={`${uid}-fullscreen-tooltip`}
													trigger={`${uid}-fullscreen`}
												>
													<media-tooltip-label />
													<media-tooltip-shortcut class="amk-tooltip-shortcut" />
												</media-tooltip>
											</>
										))}
								</media-controls-group>
							</media-tooltip-group>
						</media-controls-content>
					</media-controls>
				)}
				{hasControls && (
					<>
						{hasClickToPlay && (
							<media-gesture action="togglePaused" pointer="mouse" region="center" type="tap" />
						)}
						<media-gesture action="toggleControls" pointer="touch" type="tap" />
						<media-hotkey action="togglePaused" keys="Space" />
						<media-hotkey action="togglePaused" keys="k" />
						<media-hotkey action="toggleMuted" keys="m" />
						<media-hotkey action="seekStep" keys="ArrowLeft" />
						<media-hotkey action="seekStep" keys="ArrowRight" />
						<media-hotkey action="seekStep" keys="j" />
						<media-hotkey action="seekStep" keys="l" />
						<media-hotkey action="volumeStep" keys="ArrowUp" />
						<media-hotkey action="volumeStep" keys="ArrowDown" />
						<media-hotkey action="toggleSubtitles" keys="c" />
						{hasFullscreen && !zoom && <media-hotkey action="toggleFullscreen" keys="f" />}
						<media-status-announcer class="amk-announcer" />
					</>
				)}
			</media-container>
		</video-player>
		{isHls && hlsUrl !== undefined && hlsUrl !== '' && (
			<noscript>
				{/* eslint-disable-next-line astro/jsx-a11y/media-has-caption -- noscript fallback is minimal */}
				<video {...mediaAttributes} controls>
					<source src={hlsUrl} type="application/x-mpegURL" />
					{mp4Url !== undefined && mp4Url !== '' && <source src={mp4Url} type="video/mp4" />}
					Your browser does not support HTML5 video.
				</video>
			</noscript>
		)}
	</div>
)}
