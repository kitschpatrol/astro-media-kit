---
import type { InternalVideoProps, VideoElementTag } from './types'
import { mediaCrossOrigin } from '../utils/media'
import FallbackLink from './FallbackLink.astro'
import Icon from './Icon.astro'
import { fillLabel } from './labels'
import { labels } from './theme'
import VideoControls from './VideoControls.astro'
import VideoError from './VideoError.astro'
import VideoMedia from './VideoMedia.astro'
import './amk-fallback.css'
import './amk-video.css'

export type Props = InternalVideoProps & {
	/** Which media element to render. */
	element: VideoElementTag
	/** Where the error dialog sends the viewer to watch the video directly. */
	fallbackUrl: string
	/** HLS URL for noscript fallback. */
	hlsUrl?: string | undefined
	/** MP4 fallback URL for noscript. */
	mp4Url?: string | undefined
}

const {
	aspectRatio,
	autoPlay,
	captions,
	controls,
	duration,
	element,
	fallbackUrl,
	hlsOptions,
	hlsUrl,
	intrinsicWidth,
	loop,
	mp4Url,
	muted,
	posterUrl,
	preload,
	resolvedLabel,
	videoSrc,
	zoom,
} = Astro.props

const isHls = element === 'hlsjs-video'
const isNative = controls === 'native'
const hasControls = controls !== 'none' && !isNative
const hasFullscreen = controls === 'full' && !zoom
// Full and minimal players use their surface for playback with a mouse, and
// to show or hide the controls by touch: a region for every pointer would take
// the taps that reveal them. Only the dedicated expand button opens the
// lightbox.
const hasClickToPlay = controls === 'minimal' || controls === 'full'
const hasPoster = posterUrl !== undefined && posterUrl !== ''

// The container at the video's intrinsic width and aspect ratio, where known
const containerStyleParts: string[] = []
if (intrinsicWidth !== undefined && intrinsicWidth !== 0 && !Number.isNaN(intrinsicWidth)) {
	containerStyleParts.push(`width: ${String(intrinsicWidth)}px`)
}

if (aspectRatio !== undefined && aspectRatio !== '') {
	containerStyleParts.push(`aspect-ratio: ${aspectRatio}`)
}

const containerStyle = containerStyleParts.length > 0 ? containerStyleParts.join('; ') : undefined

const mediaAttributes: astroHTML.JSX.VideoHTMLAttributes = {
	autoplay: autoPlay || undefined,
	class: 'amk-media',
	crossorigin: mediaCrossOrigin(videoSrc, captions.length > 0),
	// No picture-in-picture control is offered, so keep the browser's own
	// affordance off the HLS element as before.
	disablepictureinpicture: isHls || undefined,
	loop: loop || undefined,
	muted: muted || undefined,
	playsinline: 'true',
	poster: posterUrl,
	preload,
}

const mediaProps = { attributes: mediaAttributes, captions, element, hlsOptions, src: videoSrc }

// Without JavaScript the player never starts. A plain video element stands in
// for it where the browser can play a source on its own, and a link to the
// video's page where only the service's embed can. A native-controls file
// already plays as it is.
const noscriptSources = (
	isHls
		? [
				{ src: hlsUrl, type: 'application/x-mpegURL' },
				{ src: mp4Url, type: 'video/mp4' },
			]
		: element === 'video' && !isNative
			? [{ src: videoSrc, type: undefined }]
			: []
).filter((source) => source.src !== undefined && source.src !== '')
const embedService =
	element === 'youtube-video' ? 'YouTube' : element === 'vimeo-video' ? 'Vimeo' : undefined
---

{!isNative && <script>
	import './videojs-ui'
</script>}

<div
	aria-label={isNative ? resolvedLabel : undefined}
	class="amk amk-video not-content"
	role={isNative ? 'group' : undefined}
>
	{isNative ? (
		<VideoMedia {...mediaProps} native={true} style={containerStyle} />
	) : (
		<video-player
			class="amk-player"
			data-click-to-play={hasClickToPlay ? '' : undefined}
			data-controls={controls}
			poster={posterUrl}
		>
			<media-container
				aria-label={resolvedLabel}
				class="amk-container"
				data-media=""
				style={containerStyle}
				tabindex={controls === 'none' ? '-1' : undefined}
			>
				<VideoMedia {...mediaProps} native={false} />
				<VideoError fallbackUrl={fallbackUrl} />
				{hasPoster && (
					<media-poster class="amk-poster">
						{/* Its own image, so the poster shows before the player's script runs */}
						<img alt="" decoding="async" src={posterUrl} />
					</media-poster>
				)}
				<media-buffering-indicator class="amk-buffering">
					<Icon name="spinner" />
				</media-buffering-indicator>
				{(hasControls || zoom) && (
					<VideoControls controls={controls} duration={duration} muted={muted} zoom={zoom} />
				)}
				{hasControls && (
					<>
						{hasClickToPlay && (
							<media-gesture action="togglePaused" pointer="mouse" region="center" type="tap" />
						)}
						<media-gesture action="toggleControls" pointer="touch" type="tap" />
						<media-hotkey action="togglePaused" keys="Space" />
						<media-hotkey action="togglePaused" keys="k" />
						<media-hotkey action="toggleMuted" keys="m" />
						<media-hotkey action="seekStep" keys="ArrowLeft" />
						<media-hotkey action="seekStep" keys="ArrowRight" />
						<media-hotkey action="seekStep" keys="j" />
						<media-hotkey action="seekStep" keys="l" />
						<media-hotkey action="volumeStep" keys="ArrowUp" />
						<media-hotkey action="volumeStep" keys="ArrowDown" />
						<media-hotkey action="toggleSubtitles" keys="c" />
						{hasFullscreen && <media-hotkey action="toggleFullscreen" keys="f" />}
					</>
				)}
			</media-container>
		</video-player>
	)}
	{noscriptSources.length > 0 && (
		<noscript>
			{/* eslint-disable-next-line astro/jsx-a11y/media-has-caption -- noscript fallback is minimal */}
			<video {...mediaAttributes} controls style={containerStyle}>
				{noscriptSources.map((source) => (
					<source {...source} />
				))}
				{labels.unsupportedVideo}
			</video>
		</noscript>
	)}
	{embedService !== undefined && (
		<FallbackLink
			href={fallbackUrl}
			label={fillLabel(labels.watchOn, { service: embedService })}
			poster={
				hasPoster && containerStyle !== undefined
					? { alt: resolvedLabel, src: posterUrl }
					: undefined
			}
			style={containerStyle}
		/>
	)}
</div>
