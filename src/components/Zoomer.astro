---
import 'liftbox/page.css'

/**
 * Ordinary HTML enhanced by Liftbox; media stays owned by the slotted
 * component.
 */
export type Props = {
	/** Enable lifting, optionally grouping items into a named gallery. */
	enabled?: boolean | string | undefined
	/**
	 * Native fallback destination, supplied by the component generating the
	 * assets.
	 */
	href?: string | undefined
	/** Secondary zoom level. */
	level?: 'fill' | 'fit' | 'native' | undefined
	/** Page preview policy. */
	placeholder?: 'auto' | 'none' | undefined
	/** Nearest ancestor that bounds the gallery. */
	scope?: string | undefined
}

const { enabled = false, href, level = 'fit', placeholder = 'auto', scope } = Astro.props
const TAG = href !== undefined && href !== '' ? 'a' : 'div'
const gallery = typeof enabled === 'string' ? enabled : ''
---

{enabled !== false && enabled !== '' ? (
	<TAG
		class="amk-zoom"
		data-liftbox={gallery}
		data-liftbox-level={level}
		data-liftbox-placeholder={placeholder}
		data-liftbox-scope={scope}
		href={href}
	>
		<slot />
	</TAG>
) : (
	<slot />
)}

<script>
	import './utils/lightbox'
</script>

<style is:global>
	.amk-zoom {
		display: block;
	}

	.liftbox-layer > .amk-picture > picture,
	.liftbox-layer > .amk-picture img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}
</style>
