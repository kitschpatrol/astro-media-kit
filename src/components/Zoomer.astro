---
import './internal/lightbox/lightbox.css'

/**
 * Wraps content the lightbox can lift into a full-screen viewer. The wrapper
 * carries everything the client needs as attributes, rendered here: the
 * gallery, the zoom level, the scope, the media's native width, and the
 * semantics of an opener, so the script enhances nothing on load.
 */
export type Props = {
	/** Enable lifting, optionally grouping items into a named gallery. */
	enabled?: boolean | string | undefined
	/**
	 * Native fallback destination, supplied by the component generating the
	 * assets. Rendered as a real link, which works before JavaScript, or, around
	 * interactive content, which a link can't wrap, as `data-href`, for a text
	 * link to the content to go to.
	 */
	href?: string | undefined
	/**
	 * The content runs its own controls, such as a video player: the wrapper is
	 * not a button, clicks inside it are left alone, and it opens from a
	 * `data-zoom-open` button of its own.
	 */
	interactive?: boolean | undefined
	/** Secondary zoom level. */
	level?: 'fill' | 'fit' | 'native' | undefined
	/**
	 * The width at which the media shows one of its pixels per CSS pixel, which
	 * the `native` level zooms to. Omit for content without pixels of its own.
	 */
	nativeWidth?: number | undefined
	/** Page preview policy. */
	placeholder?: 'auto' | 'none' | undefined
	/** Nearest ancestor that bounds the gallery. */
	scope?: string | undefined
}

const {
	enabled = false,
	href,
	interactive = false,
	level = 'fit',
	nativeWidth,
	placeholder = 'auto',
	scope,
} = Astro.props
const isEnabled = enabled !== false && enabled !== ''
const hasHref = href !== undefined && href !== ''
const isLink = hasHref && !interactive
const TAG = isLink ? 'a' : 'div'
const gallery = typeof enabled === 'string' ? enabled : undefined
// A link is operable as itself; a wrapper around interactive content opens from
// a button inside it; anything else becomes a button
const isButton = !isLink && !interactive
---

{isEnabled ? (
	<TAG
		aria-haspopup={isButton ? 'dialog' : undefined}
		class="amk-zoom"
		data-gallery={gallery}
		data-href={hasHref && !isLink ? href : undefined}
		data-interactive={interactive ? '' : undefined}
		data-level={level === 'fit' ? undefined : level}
		data-native-width={nativeWidth !== undefined && nativeWidth > 0 ? nativeWidth : undefined}
		data-placeholder={placeholder === 'none' ? placeholder : undefined}
		data-scope={scope}
		href={isLink ? href : undefined}
		role={isButton ? 'button' : undefined}
		tabindex={isButton ? '0' : undefined}
	>
		<slot />
	</TAG>
) : (
	<slot />
)}

{isEnabled && <script>
	import './internal/lightbox'
</script>}
