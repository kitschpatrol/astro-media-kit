---
// Reimplements Astro's `<Image>` component as a clean superset of the built-in.
// Upstream source (always latest `main`):
// https://github.com/withastro/astro/blob/main/packages/astro/components/Image.astro
//
// - Default output format mirrors Astro's `baseService`: SVG sources stay
//   SVG, everything else becomes WebP. User-supplied `format` wins.
// - Background compositing for opaque output formats (JPEG)
// - Caption + Zoom wrappers from the media-kit
//
// For responsive dark-mode image sources, use `<Picture>`. When given a `{ dark, light }`
// pair, this component picks `.light` and emits a dev warning.
//
// Remote `http(s)` URLs are passed through to Astro's remote image pipeline via
// `getImage()`. Features that require local file bytes (XMP credit extraction,
// background compositing) are skipped for remote sources — dev warnings surface
// when those props are set.

import type { ImageMetadata, ImageOutputFormat } from 'astro'
import type { LocalImageProps } from 'astro:assets'
import type { HTMLAttributes } from 'astro/types'
import { getImage, imageConfig } from 'astro:assets'
import type { DarkLightImageMetadata, ImageMetadataLike } from '../types'
import type { PrefixedProps as PrefixedCaptionProps } from './caption-props-map'
import type { FormatRules, GetImageResult } from './utils/image-orchestration'
import type { PrefixedProps as PrefixedZoomProps } from './zoom-props-map'
import { toCaptionProps } from './caption-props-map'
import Caption from './Caption.astro'
import { isDarkLightImageMetadata, isRemoteImageSource } from './utils/image'
import {
	buildBackgroundStyle,
	cloneImageMetadata,
	compositingBackground,
	mergeLayoutDefaults,
	pickImageFormat,
	resolveSizesAttribute,
	resolveSrc,
	resolveSrcToMetadata,
	warnBackgroundDarkWithoutBackground,
	warnRemoteIncompatibleProps,
	warnRemoteMissingDimsOrInferSize,
	warnWidthsWithoutSizes,
} from './utils/image-orchestration'
import { toZoomerProps } from './zoom-props-map'
import Zoomer from './Zoomer.astro'

/**
 * Props for the `<Image>` component — renders a single `<img>` with caption and
 * zoom support. Inherits from Astro's `LocalImageProps` (all
 * `getImage()`-compatible fields plus `<img>` HTMLAttributes); only props
 * widened, narrowed, or added by media-kit are re-declared here.
 */
export type Props = Omit<LocalImageProps, 'format' | 'height' | 'src' | 'width'> &
	PrefixedCaptionProps &
	PrefixedZoomProps & {
		/**
		 * CSS background color for the image (visible behind transparent areas).
		 * For opaque output formats (JPEG) the color is composited into the pixels
		 * via the image service; for transparent formats it's applied via inline
		 * CSS. Ignored for remote sources.
		 *
		 * Media-kit addition.
		 *
		 * @default undefined — transparency is preserved; no background color
		 *   is applied.
		 */
		background?: string | undefined
		/**
		 * Dark mode background color override. Used in conjunction with
		 * `background`; rendered via `light-dark()` so a single `<img>` responds to
		 * `prefers-color-scheme`. Ignored for remote sources.
		 *
		 * Media-kit addition.
		 *
		 * @default undefined — light mode `background` applies in both modes.
		 */
		backgroundDark?: string | undefined
		/**
		 * JSX-style class name (passed by MDX, which uses `className` instead of
		 * `class`). Merged with Astro's `class` prop (`class` wins when both are
		 * present).
		 *
		 * Media-kit addition.
		 *
		 * @default undefined — only Astro's `class` prop is applied.
		 */
		className?: string | undefined
		/**
		 * Output format for the `<img>`. Astro's built-in accepts an
		 * `ImageOutputFormat` string only; media-kit widens it to also accept a
		 * partial `FormatRules` object mapping input formats to output formats
		 * (merged on top of a rule set matching Astro's `baseService` default).
		 * Only consulted for local sources — the remote branch defers entirely to
		 * Astro's remote pipeline.
		 *
		 * Astro `<Image>` built-in (widened by media-kit).
		 *
		 * @default undefined — Astro's `baseService` default applies: `svg → svg`,
		 *   everything else (and `'unknown'` for remote sources) → `webp`.
		 */
		format?: FormatRules | ImageOutputFormat | undefined
		/**
		 * Display height in pixels. Narrowed to numeric-only — `getImage()` rejects
		 * the string-numeric form Astro's type allows.
		 *
		 * Astro `<Image>` built-in (narrowed by media-kit).
		 *
		 * @default undefined — for local sources, derived from the image's
		 *   intrinsic dimensions (combined with `width` if set). For remote
		 *   sources, omitting both `width` and `height` requires
		 *   `inferSize: true`.
		 */
		height?: number | undefined
		/**
		 * Probe the source at build time to determine its intrinsic dimensions.
		 * Required for remote sources without explicit `width` + `height` —
		 * `getImage()` throws otherwise. No-op for local sources, which already
		 * carry dimensions on the `ImageMetadata` object.
		 *
		 * Astro `<Image>` built-in (widened by media-kit).
		 *
		 * @default undefined — equivalent to `false`.
		 */
		inferSize?: boolean
		/**
		 * Image source: an `ImageMetadata` object, a `{ dark, light }` pair (only
		 * `.light` is used — use `<Picture>` for dark-mode image sources), or an
		 * absolute file path string.
		 *
		 * Astro `<Image>` built-in (widened by media-kit).
		 *
		 * @default undefined — required; rendering throws if omitted.
		 */
		src: DarkLightImageMetadata | ImageMetadata | ImageMetadataLike | string
		/**
		 * Display width in pixels. Narrowed to numeric-only — `getImage()` rejects
		 * the string-numeric form Astro's type allows.
		 *
		 * Astro `<Image>` built-in (narrowed by media-kit).
		 *
		 * @default undefined — for local sources, derived from the image's
		 *   intrinsic dimensions (combined with `height` if set). For remote
		 *   sources, omitting both `width` and `height` requires
		 *   `inferSize: true`.
		 */
		width?: number | undefined
	}

const {
	alt,
	background,
	backgroundDark,
	class: classFromAstro,
	className: classFromJsx,
	credit,
	creditMediaType,
	creditMediaTypeFallback,
	creditOrganization,
	format: formatProp,
	src,
	zoom,
	zoomLevel,
	zoomScope,
	...imageProps
} = Astro.props

const zoomerProps = toZoomerProps({ zoom, zoomLevel, zoomScope })

// Merge class from both Astro-style `class` and JSX-style `className` props
// (MDX may pass both; getImage() passes through `className` unfiltered)
const className = classFromAstro ?? classFromJsx

const isRemote = isRemoteImageSource(src)

if (isRemote) {
	warnRemoteIncompatibleProps('Image', { background, backgroundDark })
	warnRemoteMissingDimsOrInferSize('Image', src, {
		height: imageProps.height,
		inferSize: imageProps.inferSize,
		width: imageProps.width,
	})
}

// Dev-only hint when a { dark, light } pair is passed — Image silently uses
// `.light`, but the user probably meant to reach for `<Picture>` instead.
if (!isRemote && import.meta.env.DEV && isDarkLightImageMetadata(src)) {
	console.warn(
		'[astro-media-kit] Image received a { dark, light } source — rendering the `.light` variant only. Use `<Picture>` for dark-mode image sources.',
	)
}

// Handle responsive layout (same as Astro's Image) — shared by both branches.
const { merged: getImageProps, useResponsive } = mergeLayoutDefaults(imageProps, imageConfig)

let image: GetImageResult
let imageMetadataSrc: string
let captionSrc: ImageMetadata | string | undefined

if (isRemote) {
	// Remote: delegate to Astro's remote pipeline via getImage(). Astro
	// requires either `width` + `height` or `inferSize: true` on remote
	// sources — getImage() throws otherwise. A `FormatRules` map can't be
	// resolved without input format metadata, so only forward a forced string
	// (warn on the map shape).
	if (import.meta.env.DEV && formatProp && typeof formatProp !== 'string') {
		console.warn(
			"[astro-media-kit] Image received a `format` rules object on a remote source — rules-map shape requires local input format metadata. Pass a single `ImageOutputFormat` string instead, or omit `format` to use Astro's remote default.",
		)
	}

	const remoteFormat = typeof formatProp === 'string' ? formatProp : undefined
	image = await getImage({
		...getImageProps,
		...(remoteFormat ? { format: remoteFormat } : {}),
		src,
	})
	imageMetadataSrc = src
	captionSrc = undefined
} else {
	const { imageMetadata } = await resolveSrcToMetadata(src, undefined, {
		componentName: 'Image',
		darkDisabled: true,
	})

	// Clone src object to avoid Astro thinking the image is used outside optimization pipeline
	const originalSrc = await resolveSrc(imageMetadata)
	const clonedSrc = cloneImageMetadata(originalSrc)

	// Output format: resolve via `pickImageFormat`, which handles a forced
	// string, a partial `FormatRules` map, or undefined (defaults to Astro's
	// `baseService` rule — SVG stays SVG, everything else becomes WebP).
	const outputFormat = pickImageFormat(formatProp, imageMetadata)

	image = await getImage({
		...getImageProps,
		...compositingBackground(outputFormat, background),
		format: outputFormat,
		src: clonedSrc,
	})
	imageMetadataSrc = imageMetadata.src
	captionSrc = imageMetadata
}

warnBackgroundDarkWithoutBackground(background, backgroundDark, 'Image')
warnWidthsWithoutSizes(
	imageMetadataSrc,
	{
		densities: imageProps.densities ?? undefined,
		sizes: imageProps.sizes ?? undefined,
		widths: imageProps.widths ?? undefined,
	},
	useResponsive,
	'Image',
)

const { light: backgroundStyle } = buildBackgroundStyle({
	background,
	backgroundDark,
	isSelector: false,
})

// Assemble <img> attributes: let getImage's result attributes drive, pull
// `class` off (we merge it via class:list), and add our superset markers.
const imgAdditionalAttributes: HTMLAttributes<'img'> = {}

// `getImage()` returns the srcset on `.srcSet.attribute` rather than via
// `.attributes` — wire it through explicitly (matches Picture's fallback img).
if (image.srcSet.values.length > 0) {
	imgAdditionalAttributes.srcset = image.srcSet.attribute
}

if (import.meta.env.DEV) {
	imgAdditionalAttributes['data-image-component'] = 'true'
}

const { class: imgClassName, ...imgAttributes } = {
	...imgAdditionalAttributes,
	...image.attributes,
}

const resolvedSizes = resolveSizesAttribute(
	imageProps.sizes ?? undefined,
	typeof imgAttributes.sizes === 'string' ? imgAttributes.sizes : undefined,
)
if (resolvedSizes !== undefined) {
	imgAttributes.sizes = resolvedSizes
}

const captionProps = toCaptionProps(
	{ credit, creditMediaType, creditMediaTypeFallback, creditOrganization },
	{ src: captionSrc, typeFallback: 'image' },
)
---

<Caption {...captionProps}>
	<Zoomer {...zoomerProps} slot="media-component">
		<img
			alt={alt}
			src={image.src}
			{...imgAttributes}
			class:list={[className, imgClassName, 'amk']}
			style={backgroundStyle}
		/>
	</Zoomer>
	<slot />
</Caption>
