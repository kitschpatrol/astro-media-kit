---
// Reimplements Astro's `<Picture>` component as a clean superset of the
// built-in. Upstream source (always latest `main`):
// https://github.com/withastro/astro/blob/main/packages/astro/components/Picture.astro
//
// - Dark mode (via prefers-color-scheme media queries, or a custom selector)
// - `<img>` fallback selection via `fallbackFormat`, widened to accept either
//   a single forced output format (Astro built-in semantics) or a partial
//   per-input-format rules map (media-kit extension)
// - Responsive srcset mirroring the `sizes` attribute onto each <source>
// - Astro background compositing with optional CSS dark backgrounds
// - Caption + Zoom wrappers from the media-kit
//
// URL sources, including public assets, use Astro's image pipeline via
// `getImage()`. XMP extraction is available only for local metadata sources;
// URL and local metadata dark variants cannot be mixed.

import type { ImageMetadata, ImageOutputFormat, UnresolvedImageTransform } from 'astro'
import type { LocalImageProps } from 'astro:assets'
import type { HTMLAttributes } from 'astro/types'
import { getImage, imageConfig, inferRemoteSize } from 'astro:assets'
import { isESMImportedImage } from 'astro/assets/utils'
import type { DarkLightImageMetadata, ImageMetadataLike } from '../types'
import type { PrefixedProps as PrefixedCaptionProps } from './caption-props-map'
import type { FormatRules, FormatsRules, GetImageResult } from './utils/image-orchestration'
import type { PrefixedProps as PrefixedZoomProps } from './zoom-props-map'
import { toCaptionProps } from './caption-props-map'
import Caption from './Caption.astro'
import { isImageUrlSource, isRemoteImageSource } from './utils/image'
import {
	buildBackgroundStyle,
	buildSrcsetAttribute,
	compositingBackground,
	extractScopedStyleClass,
	getMimeType,
	hashSelector,
	mergeImageStyle,
	mergeLayoutDefaults,
	needsBackgroundDarkVariant,
	pickFallbackFormat,
	pickFormats,
	propagateAstroCidAttributes,
	resolveSizesAttribute,
	resolveSrc,
	resolveSrcToMetadata,
	warnBackgroundDarkWithoutBackground,
	warnRemoteLocalSrcDark,
	warnRemoteMissingDimsOrInferSize,
	warnWidthsWithoutSizes,
} from './utils/image-orchestration'
import { zoomTarget } from './utils/zoom-image'
import { toZoomerProps } from './zoom-props-map'
import Zoomer from './Zoomer.astro'

/**
 * Props for the `<Picture>` component — renders `<picture>` with dark mode,
 * responsive sources, and zoom. Inherits from Astro's `LocalImageProps` (all
 * `getImage()`-compatible fields plus `<img>` HTMLAttributes) and Astro's
 * `<Picture>` extras (`formats`, `pictureAttributes`); only props widened or
 * added by media-kit are re-declared here.
 */
export type Props = Omit<LocalImageProps, 'height' | 'src' | 'width'> &
	PrefixedCaptionProps &
	PrefixedZoomProps & {
		/**
		 * Astro's compositing background, also applied as a CSS background. When
		 * `backgroundDark` is supplied, transparent output formats keep their
		 * transparency so CSS can switch colors; JPEG still uses pixel
		 * compositing.
		 *
		 * Astro `<Picture>` built-in, extended with CSS background styling.
		 *
		 * @default undefined — transparency is preserved; no background color
		 *   is applied.
		 */
		background?: string | undefined
		/**
		 * Dark mode background color override. Used in conjunction with
		 * `background`. In media mode (`darkMode: 'media'`) it's rendered via CSS
		 * `light-dark()` so a single `<img>` responds to `prefers-color-scheme`. In
		 * selector mode (`darkMode` set to a CSS selector) the component emits a
		 * second `<picture>` carrying the dark background-color inline, since
		 * `light-dark()` can't toggle on a custom selector.
		 *
		 * Media-kit addition.
		 *
		 * @default undefined — light mode `background` applies in both modes.
		 */
		backgroundDark?: string | undefined
		/**
		 * JSX-style class name (passed by MDX, which uses `className` instead of
		 * `class`). Merged with Astro's `class` prop (`class` wins when both are
		 * present).
		 *
		 * Media-kit addition.
		 *
		 * @default undefined — only Astro's `class` prop is applied.
		 */
		className?: string | undefined
		/**
		 * Dark mode switching strategy.
		 *
		 * - `'media'`: `prefers-color-scheme` media queries on `<source>` elements.
		 *   Follows the OS/browser color scheme preference.
		 * - `'none'`: disables all dark mode behavior (image sources and
		 *   backgrounds).
		 * - Any other string: a CSS selector (e.g. `"[data-theme='dark']"`,
		 *   `".dark"`) that triggers dark mode. Renders two `<picture>` elements
		 *   toggled via injected CSS. Use this for frameworks like Starlight
		 *   (`[data-theme='dark']`) or Tailwind (`.dark`) that control dark mode
		 *   via a class or attribute rather than the OS preference.
		 *
		 * Media-kit addition.
		 *
		 * @default 'media' — follows `prefers-color-scheme`.
		 */
		darkMode?: 'media' | 'none' | (string & {})
		/**
		 * Output format for the `<img>` fallback. Astro's built-in accepts an
		 * `ImageOutputFormat` string only; media-kit widens it to also accept a
		 * partial `FormatRules` object mapping input formats to fallback output
		 * formats (merged on top of a rule set matching Astro's defaults).
		 *
		 * Astro `<Picture>` built-in (widened by media-kit).
		 *
		 * @default undefined — Astro's per-input-format defaults apply:
		 *   `gif → gif`, `svg → svg`, `jpg → jpg`, `jpeg → jpeg`, everything
		 *   else (and `'unknown'` for remote sources) → `png`.
		 */
		fallbackFormat?: FormatRules | ImageOutputFormat | undefined
		/**
		 * Output formats for `<source>` elements. One `<source>` is emitted per
		 * format, in order. Astro's built-in accepts an `ImageOutputFormat[]` only;
		 * media-kit widens it to also accept a partial `FormatsRules` object
		 * mapping input formats to output-format lists (merged on top of a rule set
		 * matching Astro's defaults). An empty array entry (`{ svg: [] }`) skips
		 * preferred sources; the `<img>` carries the light fallback, and a dark
		 * fallback `<source>` is still emitted when needed for theme switching.
		 *
		 * Astro `<Picture>` built-in (widened by media-kit).
		 *
		 * @default undefined — Astro's per-input default applies: `['webp']` for
		 *   every input format (and `'unknown'` for remote sources). Pass
		 *   `formats={{ svg: ['svg'] }}` to preserve SVGs as vectors.
		 */
		formats?: FormatsRules | ImageOutputFormat[] | undefined
		/**
		 * Display height in pixels. Accepts numbers and Astro's numeric strings.
		 *
		 * Astro `<Picture>` built-in.
		 *
		 * @default undefined — for local sources, derived from the image's
		 *   intrinsic dimensions (combined with `width` if set). For remote
		 *   sources, omitting both `width` and `height` requires
		 *   `inferSize: true`.
		 */
		height?: LocalImageProps['height']
		/**
		 * Probe the source at build time to determine its intrinsic dimensions.
		 * Required for remote sources without explicit `width` + `height` —
		 * `getImage()` throws otherwise. No-op for local sources, which already
		 * carry dimensions on the `ImageMetadata` object.
		 *
		 * Astro `<Picture>` built-in (widened by media-kit).
		 *
		 * @default undefined — equivalent to `false`.
		 */
		inferSize?: boolean
		/**
		 * HTML attributes spread onto the outer `<picture>` (or wrapping `<div>` in
		 * selector mode).
		 *
		 * Astro `<Picture>` built-in.
		 *
		 * @default {}
		 */
		pictureAttributes?: HTMLAttributes<'picture'> | undefined
		/**
		 * Astro image metadata, an import promise, or a public/remote image URL.
		 * Also accepts local filesystem paths and `{ dark, light }` metadata
		 * pairs.
		 *
		 * Astro `<Picture>` built-in (widened by media-kit).
		 *
		 * @default undefined — required; rendering throws if omitted.
		 */
		src: DarkLightImageMetadata | ImageMetadataLike | LocalImageProps['src'] | string
		/**
		 * Dark mode image variant. Rendered via `prefers-color-scheme` media query
		 * on `<source>`. Pass `false` to disable auto dark mode generation from a
		 * `{ dark, light }` `src` pair.
		 *
		 * Media-kit addition.
		 *
		 * @default undefined — when `src` is a `{ dark, light }` pair, `.dark`
		 *   is used automatically; otherwise no dark variant is emitted.
		 */
		srcDark?: boolean | ImageMetadata | ImageMetadataLike | string | undefined
		/**
		 * Display width in pixels. Accepts numbers and Astro's numeric strings.
		 *
		 * Astro `<Picture>` built-in.
		 *
		 * @default undefined — for local sources, derived from the image's
		 *   intrinsic dimensions (combined with `height` if set). For remote
		 *   sources, omitting both `width` and `height` requires
		 *   `inferSize: true`.
		 */
		width?: LocalImageProps['width']
		/**
		 * Show a decorative corner indicator when zoom is enabled. A custom
		 * `zoom-indicator` slot enables it unless this is explicitly false.
		 */
		zoomIndicator?: boolean | undefined
	}

const {
	alt,
	background,
	backgroundDark: backgroundDarkProp,
	class: classFromAstro,
	className: classFromJsx,
	credit,
	creditMediaType,
	creditMediaTypeFallback,
	creditOrganization,
	darkMode = 'media',
	fallbackFormat: fallbackFormatProp,
	formats: formatsProp,
	pictureAttributes: pictureAttributesProp = {},
	src,
	srcDark: srcDarkProp,
	zoom,
	zoomIndicator,
	zoomLevel,
	zoomPlaceholder,
	zoomScope,
	...imageProps
} = Astro.props

const isZoomEnabled = !['', false, undefined].includes(zoom)
const zoomerProps = toZoomerProps({ zoom, zoomLevel, zoomPlaceholder, zoomScope })

// Merge class from both Astro-style `class` and JSX-style `className` props
// (MDX may pass both; getImage() passes through `className` unfiltered)
const className = classFromAstro ?? classFromJsx

// Dark mode strategy
const isSelector = darkMode !== 'media' && darkMode !== 'none'
const isNone = darkMode === 'none'

if (isSelector && /[\{\}<>;]/v.test(darkMode)) {
	throw new Error(
		`Picture darkMode selector "${darkMode}" contains invalid characters. ` +
			'Provide a valid CSS selector (e.g. "[data-theme=\'dark\']", ".dark").',
	)
}

// When darkMode='none', suppress all dark behavior
const backgroundDark = isNone ? undefined : backgroundDarkProp

// Normalize srcDark: true/undefined = auto, false = disabled, other = explicit source
const darkDisabled = isNone || srcDarkProp === false
const srcDarkSource =
	isNone || typeof srcDarkProp === 'boolean' || srcDarkProp === undefined ? undefined : srcDarkProp

const resolvedSource = await resolveSrc(src)
const isRemote = typeof resolvedSource === 'string' && isImageUrlSource(resolvedSource)

// Branch: remote URL sources skip metadata probing and use Astro's remote pipeline.
let lightSrc: ImageMetadata | string
let darkSrc: ImageMetadata | string | undefined

if (isRemote) {
	const srcDarkIsLocal = srcDarkSource !== undefined && !isImageUrlSource(srcDarkSource)
	if (srcDarkIsLocal) {
		warnRemoteLocalSrcDark('Picture')
	}

	warnRemoteMissingDimsOrInferSize('Picture', resolvedSource, {
		height: imageProps.height,
		inferSize: imageProps.inferSize,
		width: imageProps.width,
	})
	lightSrc = resolvedSource
	darkSrc =
		darkDisabled || typeof srcDarkSource !== 'string' || srcDarkIsLocal ? undefined : srcDarkSource
} else {
	const { imageMetadata, imageMetadataDark } = await resolveSrcToMetadata(
		resolvedSource,
		srcDarkSource,
		{
			componentName: 'Picture',
			darkDisabled,
		},
	)
	lightSrc = imageMetadata
	darkSrc = imageMetadataDark
}

// Propagate scoped style class to picture element
const pictureAttributes = { ...pictureAttributesProp }
const scopedStyleClass = extractScopedStyleClass(className)
if (scopedStyleClass !== undefined && scopedStyleClass !== '') {
	const existingClass = pictureAttributes.class ?? undefined
	pictureAttributes.class =
		existingClass === undefined || existingClass === ''
			? scopedStyleClass
			: `${existingClass} ${scopedStyleClass}`
}

// Astro types `widths`/`densities`/`layout` as a discriminated union. Our `Omit<>`-derived
// Props flatten that union, so we cast at the `getImage()` boundary like Astro's own `<Image>` does.

// Handle responsive layout (same as Astro's Picture)
const { merged: mergedImageProps, useResponsive } = mergeLayoutDefaults(imageProps, imageConfig)

// Probe a remote size once and thread it through every transform, as Astro's
// own Picture does: repeated probes of one URL can be rate-limited.
if (mergedImageProps.inferSize && isRemoteImageSource(lightSrc)) {
	const remoteSize = await inferRemoteSize(lightSrc)
	delete mergedImageProps.inferSize
	mergedImageProps.width ??= remoteSize.width
	mergedImageProps.height ??= remoteSize.height
}

// Propagate data-astro-cid-* attributes to picture element
propagateAstroCidAttributes(mergedImageProps, pictureAttributes)

// Generate optimized images for each format (light variant)
const originalSrc = isRemote ? lightSrc : await resolveSrc(lightSrc)

// Resolve `formats` against the source. `pickFormats` handles the three shapes
// of `formats`: array (force), object (partial rules merged onto defaults),
// undefined (defaults — remote/string sources land on `'unknown'`).
const formats = pickFormats(formatsProp, originalSrc)

// Include the fallback format when deciding whether dark backgrounds need
// their own composited image, even if every preferred format is transparent.
const resultFallbackFormat = pickFallbackFormat(fallbackFormatProp, originalSrc)

const optimizedImages: GetImageResult[] = await Promise.all(
	formats.map(async (format) =>
		getImage({
			...mergedImageProps,
			...compositingBackground(format, background, backgroundDark),
			densities: imageProps.densities,
			format,
			src: originalSrc,
			widths: imageProps.widths,
		} as UnresolvedImageTransform),
	),
)

// Generate optimized images for dark variant when:
// 1. A separate dark source image is provided (srcDark), or
// 2. backgroundDark differs from background on an opaque format (same source, different composited bg), or
// 3. backgroundDark differs from background in selector mode (same source, dark <picture> carries the
//    swapped inline background-color — CSS light-dark() can't toggle on a custom selector)
const needsDarkVariant =
	darkSrc !== undefined ||
	needsBackgroundDarkVariant(
		[...formats, resultFallbackFormat],
		background,
		backgroundDark,
		darkDisabled,
		isSelector,
	)
let optimizedImagesDark: GetImageResult[] | undefined
if (needsDarkVariant) {
	const darkBackground = backgroundDark ?? background
	const originalSrcDark = isRemote
		? (darkSrc ?? originalSrc)
		: darkSrc === undefined
			? originalSrc
			: await resolveSrc(darkSrc)
	optimizedImagesDark = await Promise.all(
		formats.map(async (format) =>
			getImage({
				...mergedImageProps,
				...compositingBackground(format, darkBackground, backgroundDark),
				densities: imageProps.densities,
				format,
				src: originalSrcDark,
				widths: imageProps.widths,
			} as UnresolvedImageTransform),
		),
	)
}

// Generate fallback image (always light variant)
const fallbackImage = await getImage({
	...mergedImageProps,
	...compositingBackground(resultFallbackFormat, background, backgroundDark),
	densities: imageProps.densities,
	format: resultFallbackFormat,
	src: originalSrc,
	widths: imageProps.widths,
} as UnresolvedImageTransform)

// Reading `src` on an imported image records a raw reference that keeps the
// original file in the build output. The transform's own copy is untracked.
const transformedSrc = fallbackImage.options.src
const lightSrcLabel = isESMImportedImage(transformedSrc) ? transformedSrc.src : transformedSrc
const captionSrc = isESMImportedImage(transformedSrc) ? transformedSrc : undefined

const hasDarkMode = optimizedImagesDark !== undefined

// Selector mode needs its own <img>. Media mode needs a dark fallback <source>
// when no preferred format is supported, including an empty formats list.
let fallbackImageDark: GetImageResult | undefined
if (hasDarkMode && (isSelector || !formats.includes(resultFallbackFormat))) {
	const darkBackground = backgroundDark ?? background
	const originalSrcDark = isRemote
		? (darkSrc ?? originalSrc)
		: darkSrc === undefined
			? originalSrc
			: await resolveSrc(darkSrc)
	fallbackImageDark = await getImage({
		...mergedImageProps,
		...compositingBackground(resultFallbackFormat, darkBackground, backgroundDark),
		densities: imageProps.densities,
		format: resultFallbackFormat,
		src: originalSrcDark,
		widths: imageProps.widths,
	} as UnresolvedImageTransform)
}

const imgAdditionalAttributes: HTMLAttributes<'img'> = {}
const sourceAdditionalAttributes: HTMLAttributes<'source'> = {}

// Mirror the `sizes` attribute onto <source> elements. Astro's getImage()
// emits `sizes` on `fallbackImage.attributes` for responsive layouts, but the
// <img> fallback never wins once a <source> matches. Without `sizes` on the
// source, the browser defaults to `100vw` and always picks the largest
// candidate from a width-descriptor srcset.
const fallbackSizes =
	typeof fallbackImage.attributes.sizes === 'string' ? fallbackImage.attributes.sizes : undefined
// All source branches share sizing hints. Include the fallback when avoiding
// Safari's SVG painting bug, even when a preferred source is a raster format.
const effectiveSizes = resolveSizesAttribute(
	imageProps.sizes ?? undefined,
	fallbackSizes,
	!formats.includes('svg') && resultFallbackFormat !== 'svg',
)
if (effectiveSizes !== undefined && effectiveSizes !== '') {
	sourceAdditionalAttributes.sizes = effectiveSizes
}

if (fallbackImage.srcSet.values.length > 0) {
	imgAdditionalAttributes.srcset = fallbackImage.srcSet.attribute
}

if (import.meta.env.DEV) {
	imgAdditionalAttributes['data-image-component'] = 'true'
}

const {
	class: imgClassName,
	style: imgStyle,
	...imgAttributes
} = {
	...imgAdditionalAttributes,
	...fallbackImage.attributes,
}

// Mirror the resolved sizes (with "auto, " prefix for auto-generated values)
// onto the <img> fallback too.
if (effectiveSizes !== undefined) {
	imgAttributes.sizes = effectiveSizes
}

// Build dark fallback img attributes for selector mode
let imgClassNameDark: string | undefined
let imgStyleDark: HTMLAttributes<'img'>['style']
let imgAttributesDark: Record<string, unknown> = {}
if (fallbackImageDark) {
	const imgAdditionalAttributesDark: HTMLAttributes<'img'> = {}
	if (fallbackImageDark.srcSet.values.length > 0) {
		imgAdditionalAttributesDark.srcset = fallbackImageDark.srcSet.attribute
	}

	if (import.meta.env.DEV) {
		imgAdditionalAttributesDark['data-image-component'] = 'true'
	}

	const {
		class: cls,
		style,
		...attributes
	} = {
		...imgAdditionalAttributesDark,
		...fallbackImageDark.attributes,
	}
	if (effectiveSizes !== undefined) {
		attributes.sizes = effectiveSizes
	}

	imgClassNameDark = cls ?? undefined
	imgStyleDark = style
	imgAttributesDark = attributes
}

const captionProps = await toCaptionProps(
	{ credit, creditMediaType, creditMediaTypeFallback, creditOrganization },
	{ src: captionSrc, typeFallback: 'image' },
)

warnBackgroundDarkWithoutBackground(background, backgroundDark, 'Picture')
warnWidthsWithoutSizes(
	lightSrcLabel,
	{
		densities: imageProps.densities ?? undefined,
		sizes: imageProps.sizes ?? undefined,
		widths: imageProps.widths ?? undefined,
	},
	useResponsive,
	'Picture',
)

const { dark: backgroundStyleDark, light: backgroundStyle } = buildBackgroundStyle({
	background,
	backgroundDark,
	isSelector,
})

// Template-level srcset helper — closes over the relevant props so the template stays tidy
const srcsetFor = (image: GetImageResult): string =>
	buildSrcsetAttribute(image, imageProps, useResponsive)

// Build injected <style> for selector mode
let selectorStyle: string | undefined
let selectorClass: string | undefined
if (isSelector && hasDarkMode) {
	// Scope each selector's pairs, and group selector lists before appending
	// the descendant. Otherwise a selector from another Picture can toggle this
	// pair, or a comma-separated selector can hide the theme container itself.
	selectorClass = `amk-picture-${await hashSelector(darkMode)}`
	selectorStyle = `<style>.${selectorClass}>picture.amk-dark{display:none}:is(${darkMode}) .${selectorClass}>picture.amk-dark{display:block}:is(${darkMode}) .${selectorClass}>picture.amk-light{display:none}</style>`
}
---

{selectorStyle !== undefined && selectorStyle !== '' && <Fragment set:html={selectorStyle} />}
<Caption {...captionProps}>
	<Zoomer
		{...zoomerProps}
		{...zoomTarget(fallbackImage)}
		indicator={zoomIndicator ?? Astro.slots.has('zoom-indicator')}
		slot="media-component"
	>
		{isSelector && hasDarkMode ? (
			<div
				{...pictureAttributes}
				class:list={[pictureAttributes.class, 'amk-picture', selectorClass]}
			>
				<picture class="amk-dark">
					{optimizedImagesDark!.map((image) => (
						<source
							srcset={srcsetFor(image)}
							type={getMimeType(image)}
							{...sourceAdditionalAttributes}
						/>
					))}
					<img
						alt={alt}
						data-media={isZoomEnabled ? '' : undefined}
						src={fallbackImageDark!.src}
						{...imgAttributesDark}
						class:list={[className, imgClassNameDark, 'amk']}
						style={mergeImageStyle(imgStyleDark, backgroundStyleDark)}
					/>
				</picture>
				<picture class="amk-light">
					{optimizedImages.map((image) => (
						<source
							srcset={srcsetFor(image)}
							type={getMimeType(image)}
							{...sourceAdditionalAttributes}
						/>
					))}
					<img
						alt={alt}
						data-media={isZoomEnabled ? '' : undefined}
						src={fallbackImage.src}
						{...imgAttributes}
						class:list={[className, imgClassName, 'amk']}
						style={mergeImageStyle(imgStyle, backgroundStyle)}
					/>
				</picture>
			</div>
		) : (
			<picture {...pictureAttributes}>
				{hasDarkMode &&
					optimizedImagesDark!.map((image) => (
						<source
							media="(prefers-color-scheme: dark)"
							srcset={srcsetFor(image)}
							type={getMimeType(image)}
							{...sourceAdditionalAttributes}
						/>
					))}
				{fallbackImageDark && (
					<source
						media="(prefers-color-scheme: dark)"
						srcset={srcsetFor(fallbackImageDark)}
						type={getMimeType(fallbackImageDark)}
						{...sourceAdditionalAttributes}
					/>
				)}
				{optimizedImages.map((image) => (
					<source
						media={hasDarkMode ? '(prefers-color-scheme: light)' : undefined}
						srcset={srcsetFor(image)}
						type={getMimeType(image)}
						{...sourceAdditionalAttributes}
					/>
				))}
				<img
					alt={alt}
					src={fallbackImage.src}
					{...imgAttributes}
					class:list={[className, imgClassName, 'amk']}
					style={mergeImageStyle(imgStyle, backgroundStyle)}
				/>
			</picture>
		)}
		{Astro.slots.has('zoom-indicator') && (
			<Fragment slot="indicator">
				<slot name="zoom-indicator" />
			</Fragment>
		)}
	</Zoomer>
	<slot />
</Caption>
