{
	"extends": "@kitschpatrol/typescript-config/astro",
	"compilerOptions": {
		// Additions from Astro's strictest tsconfig not covered by the extended config
		"types": [
			"@kitschpatrol/unplugin-tldraw/client",
			"@kitschpatrol/unplugin-aphex/client",
			"node"
		],
		"allowUnusedLabels": false
	},
	// Overrides the extended include entirely: adds project dot-files for
	// typescript-eslint integration, and lists nested .astro/types.d.ts files
	// explicitly since `**` doesn't match dot-directories
	"include": [
		"**/*",
		"**/**.*",
		".astro/types.d.ts",
		"./playground-starlight/.astro/types.d.ts",
		"./playground/.astro/types.d.ts",
		"./test/parity/fixtures/core-image/.astro/types.d.ts",
		"./test/parity/fixtures/picture-darkmode/.astro/types.d.ts"
	],
	"exclude": ["**/dist/", "**/bin/", "**/node_modules/"],
	"mdx": {
		"plugins": ["remark-directive", "remark-attribute-list"]
	}
}
