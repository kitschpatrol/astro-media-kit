{
	"extends": "@kitschpatrol/typescript-config",
	"compilerOptions": {
		// Additions and changes from Astro's strictest tsconfig
		// vs. the extended @kitschpatrol/typescript-config
		"target": "ESNext",
		"jsx": "preserve",
		"jsxImportSource": "astro",
		"types": ["@kitschpatrol/unplugin-tldraw/client", "@kitschpatrol/unplugin-aphex/client"],
		"allowUnusedLabels": false,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true
	},
	// Includes project dot-files files for typescript-eslint integration
	"include": [
		"**/*",
		"**/**.*",
		".astro/types.d.ts",
		"./playground-starlight/.astro/types.d.ts",
		"./playground/.astro/types.d.ts",
		"./test/parity/fixtures/core-image/.astro/types.d.ts",
		"./test/parity/fixtures/picture-darkmode/.astro/types.d.ts"
	],
	// The playground-starlight Astro config is excluded because Starlight 0.40 ships TypeScript
	// source that fails type checking when imported. It's still covered by `astro check`.
	// See https://github.com/withastro/starlight/issues/3950
	"exclude": ["**/dist/", "**/bin/", "**/node_modules/", "playground-starlight/astro.config.ts"],
	"mdx": {
		"plugins": ["remark-directive", "remark-attribute-list"]
	}
}
