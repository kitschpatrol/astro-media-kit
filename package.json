{
	"name": "astro-media-kit",
	"version": "0.5.3",
	"description": "Astro components for images and video.",
	"keywords": [
		"astro",
		"astro-integration",
		"astro-component",
		"tldraw",
		"tldr",
		"aphex",
		"import",
		"apple-photos",
		"cloudflare",
		"mux",
		"image",
		"video",
		"bunny",
		"components",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-media-kit",
	"bugs": "https://github.com/kitschpatrol/astro-media-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-media-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./components": "./src/components.ts",
		"./components/*": "./src/components/*"
	},
	"files": [
		"src"
	],
	"scripts": {
		"build": "pnpm astro sync && pnpm run -r --workspace-concurrency=1 astro sync",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "pnpm -C playground run dev",
		"dev-starlight": "pnpm -C playground-starlight run dev",
		"fix": "ksc fix",
		"init": "pnpm -C playground run init",
		"lint": "ksc lint",
		"release": "bumpp --commit 'Release: %s' && pnpm build && npm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"@astrojs/compiler": "4.0.0",
		"@kitschpatrol/unplugin-aphex": "^0.2.3",
		"@kitschpatrol/unplugin-tldraw": "^1.1.3",
		"@mux/mux-node": "^15.5.0",
		"@oscnord/get-video-resolution": "^1.1.1",
		"@sindresorhus/is": "^8.1.0",
		"exiftool-vendored": "^38.3.0",
		"hls-video-element": "^1.5.11",
		"linkedom": "^0.18.13",
		"media-chrome": "^4.19.3",
		"mrmime": "^2.0.1",
		"photoswipe": "^5.4.4",
		"photoswipe-dynamic-caption-plugin": "^1.2.7",
		"pretty-bytes": "^7.2.0",
		"vimeo-video-element": "^1.7.3",
		"youtube-video-element": "^1.9.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@kitschpatrol/shared-config": "^8.10.1",
		"@types/node": "~24.13.6",
		"astro": "^7.3.5",
		"bumpp": "^12.3.0",
		"cheerio": "^1.2.0",
		"happy-dom": "^20.14.5",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.1.0",
		"sharp": "^0.35.5",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"astro": "^7.3.3"
	},
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
