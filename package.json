{
	"name": "astro-media-kit",
	"version": "0.6.0",
	"description": "Astro components for images and video.",
	"keywords": [
		"astro",
		"astro-integration",
		"astro-component",
		"tldraw",
		"tldr",
		"aphex",
		"import",
		"apple-photos",
		"cloudflare",
		"mux",
		"image",
		"video",
		"bunny",
		"components",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-media-kit",
	"bugs": "https://github.com/kitschpatrol/astro-media-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-media-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": [
		"**/*.astro",
		"**/*.css",
		"./src/components/internal/carousel/index.ts",
		"./src/components/internal/lightbox/index.ts",
		"./src/components/internal/videojs-controls.ts",
		"./src/components/internal/videojs-media.ts",
		"./src/components/internal/videojs-move.ts",
		"./src/components/internal/videojs-mute-button.ts",
		"./src/components/internal/videojs-player.ts",
		"./src/components/internal/videojs-ui.ts"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./components": "./src/components.ts",
		"./components/*": "./src/components/*"
	},
	"files": [
		"src"
	],
	"scripts": {
		"build": "pnpm astro sync && pnpm run -r --workspace-concurrency=1 astro sync",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "pnpm -C playground run dev",
		"dev-starlight": "pnpm -C playground-starlight run dev",
		"fix": "ksc fix",
		"init": "pnpm -C playground run init",
		"lint": "ksc lint",
		"prepare": "pnpm build",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"@astrojs/compiler": "4.0.0",
		"@kitschpatrol/unplugin-aphex": "^0.2.4",
		"@kitschpatrol/unplugin-tldraw": "^1.1.4",
		"@mux/ts": "^15.6.1",
		"@oscnord/get-video-resolution": "^2.5.0",
		"@sindresorhus/is": "^8.1.0",
		"@videojs/hlsjs-video": "^10.0.0",
		"@videojs/html": "^10.0.0",
		"@videojs/vimeo-video": "^10.0.0",
		"@videojs/youtube-video": "^10.0.0",
		"exiftool-vendored": "^38.3.0",
		"linkedom": "^0.18.13",
		"mrmime": "^2.0.1",
		"pretty-bytes": "^7.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@kitschpatrol/shared-config": "^8.14.0",
		"@types/node": "~24.13.6",
		"@vitest/browser-playwright": "^5.0.5",
		"astro": "^7.3.8",
		"bumpp": "^12.3.0",
		"cheerio": "^1.2.0",
		"happy-dom": "^20.14.6",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.1.0",
		"playwright": "1.63.0",
		"sharp": "^0.35.5",
		"shx": "^0.4.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"astro": "^7.3.3"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
