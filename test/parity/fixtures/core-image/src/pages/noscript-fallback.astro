---
import { Audio } from 'astro-media-kit/components'
import Oembed from 'astro-media-kit/components/internal/OEmbed.astro'
import VideoPlayer from 'astro-media-kit/components/internal/VideoPlayer.astro'
const videoProps = {
	aspectRatio: '16 / 9',
	autoPlay: false,
	captions: [],
	controls: 'full' as const,
	element: 'video' as const,
	fallbackUrl: '/media/loop.mp4',
	hlsOptions: {},
	intrinsicWidth: 640,
	loop: false,
	muted: true,
	posterUrl: '/media/loop-poster.jpg',
	preload: 'metadata' as const,
	resolvedLabel: 'Test video',
	videoSrc: '/media/loop.mp4',
	zoom: false,
}
const youtubeUrl = 'https://www.youtube.com/watch?v=aqz-KE-bpKQ'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Fallbacks without JavaScript</title>
	</head>
	<body>
		<section id="local">
			<VideoPlayer {...videoProps} />
		</section>
		<section id="local-native">
			<VideoPlayer {...videoProps} controls="native" />
		</section>
		<section id="hls-native">
			<VideoPlayer
				{...videoProps}
				controls="native"
				element="hlsjs-video"
				hlsUrl="/hls/stream.m3u8"
				mp4Url="/media/loop.mp4"
				videoSrc="/hls/stream.m3u8"
			/>
		</section>
		<section id="youtube">
			<VideoPlayer
				{...videoProps}
				element="youtube-video"
				fallbackUrl={youtubeUrl}
				resolvedLabel="YouTube video"
				videoSrc={youtubeUrl}
			/>
		</section>
		<section id="vimeo-native">
			<VideoPlayer
				{...videoProps}
				controls="native"
				element="vimeo-video"
				fallbackUrl="https://vimeo.com/76979871"
				posterUrl={undefined}
				videoSrc="https://vimeo.com/76979871"
			/>
		</section>
		<section id="audio">
			<Audio
				autoPlay
				label="Test audio"
				loop
				muted
				preload="none"
				service="local"
				src="/media/loop.mp4"
			/>
		</section>
		<section id="oembed-video">
			<Oembed
				aspectRatio="854 / 480"
				href="https://www.ted.com/talks/a_talk"
				html={'<iframe src="about:blank" width="854" height="480" frameborder="0"></iframe>'}
				linkLabel="Watch on TED"
				posterUrl="/media/loop-poster.jpg"
				resolvedLabel="A talk"
			/>
		</section>
		<section id="oembed-audio">
			<Oembed
				href="https://open.spotify.com/track/a_track"
				html={'<iframe src="about:blank" width="456" height="152"></iframe>'}
				linkLabel="Listen on Spotify"
				posterUrl="/media/loop-poster.jpg"
				resolvedLabel="A track"
			/>
		</section>
		<section id="soundcloud-id">
			<Audio src="6836449" />
		</section>
		<section id="soundcloud-url">
			<Audio src="https://soundcloud.com/kitschpatrol/drona" />
		</section>
		<section id="soundcloud-uppercase">
			<Audio src="HTTPS://soundcloud.com/kitschpatrol/drona" />
		</section>
	</body>
</html>
