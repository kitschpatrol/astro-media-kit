---
import { Image as MediaKitImage, Picture as MediaKitPicture } from 'astro-media-kit/components'
import { Image as AstroImage, Picture as AstroPicture } from 'astro:assets'
import penguin from '../assets/penguin1.jpg'
---

<html>
	<body>
		<MediaKitImage
			alt="a penguin"
			densities={[1.5, 2]}
			height={200}
			id="local"
			src={penguin}
			width={300}
		/>
		<AstroImage
			alt="a penguin"
			densities={[1.5, 2]}
			height={200}
			id="astro"
			src={penguin}
			width={300}
		/>
		<MediaKitPicture
			alt="a penguin"
			densities={[1, 2]}
			height={200}
			id="local-picture"
			src={penguin}
			width={300}
		/>
		<AstroPicture
			alt="a penguin"
			densities={[1, 2]}
			height={200}
			id="astro-picture"
			src={penguin}
			width={300}
		/>
	</body>
</html>
