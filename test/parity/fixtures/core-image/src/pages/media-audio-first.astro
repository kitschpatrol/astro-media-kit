---
import PlayerOrder from '../components/PlayerOrder.astro'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>Audio controls register first</title>
	</head>
	<body>
		<PlayerOrder />
	</body>
</html>

<script>
	async function initialize() {
		await import('astro-media-kit/components/internal/videojs-audio.ts')
		document.documentElement.dataset.firstHasSeek = String(
			Boolean(customElements.get('media-seek-button')),
		)
		document.documentElement.dataset.firstHasFullscreen = String(
			Boolean(customElements.get('media-fullscreen-button')),
		)
		await import('astro-media-kit/components/internal/videojs-ui.ts')
	}

	void initialize()
</script>
