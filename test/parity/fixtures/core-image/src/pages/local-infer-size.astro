---
import { Image as MediaKitImage } from 'astro-media-kit/components'
import { Image as AstroImage } from 'astro:assets'
import penguin from '../assets/penguin1.jpg'
---

<html>
	<body>
		<MediaKitImage alt="a penguin" height={200} id="local" inferSize src={penguin} width={300} />
		<AstroImage alt="a penguin" height={200} id="astro" inferSize src={penguin} width={300} />
	</body>
</html>
