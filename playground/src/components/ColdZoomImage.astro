---
import Zoomer from 'astro-media-kit/components/Zoomer.astro'
import { getImage } from 'astro:assets'
import darkPhoto from '../assets/test-dark.jpeg'
import photo from '../assets/test.jpeg'

type Props = {
	dark?: boolean
	zoom?: boolean | string
}

const { dark = false, zoom = true } = Astro.props
const source = dark ? darkPhoto : photo
const thumbnail = await getImage({ format: 'webp', src: source, width: 320 })
---

<demo-cold-zoom>
	<Zoomer
		enabled={zoom}
		href={dark ? '/zoom-cold-image?variant=dark' : '/zoom-cold-image'}
		indicator
		nativeWidth={source.width}
	>
		<img
			alt={
				dark
					? 'Dark version of a green character wearing a purple nightcap and holding a tablet'
					: 'Green character wearing a purple nightcap and holding a tablet'
			}
			decoding="async"
			height={source.height}
			loading="lazy"
			sizes="auto"
			src={thumbnail.src}
			srcset={`${thumbnail.src} 320w`}
			width={source.width}
		/>
	</Zoomer>
</demo-cold-zoom>

<script>
	class ColdZoomImage extends HTMLElement {
		#observer: MutationObserver | undefined

		connectedCallback() {
			const item = this.querySelector<HTMLAnchorElement>('.amk-zoom')
			const image = item?.querySelector('img')
			if (!item || !image) {
				return
			}

			const thumbnail = image.cloneNode() as HTMLImageElement
			let current = image
			let lifted = false
			this.#observer = new MutationObserver(() => {
				const next = Object.hasOwn(item.dataset, 'lifted')
				if (next === lifted) {
					return
				}

				lifted = next
				if (lifted) {
					const large = new URL(item.href)
					large.searchParams.set('request', crypto.randomUUID())
					// Start after the viewer captures the thumbnail, including when a
					// neighboring gallery item is lifted without a click of its own.
					current.srcset = `${thumbnail.srcset}, ${large.href} ${current.getAttribute('width') ?? current.naturalWidth}w`
					return
				}

				// A returned img can retain decoded pixels even with no-store. Start
				// the next opening from a fresh thumbnail after the real image lands.
				const replacement = thumbnail.cloneNode() as HTMLImageElement
				current.replaceWith(replacement)
				current = replacement
			})
			this.#observer.observe(item, { attributeFilter: ['data-lifted'], attributes: true })
		}

		disconnectedCallback() {
			this.#observer?.disconnect()
		}
	}

	if (customElements.get('demo-cold-zoom') === undefined) {
		customElements.define('demo-cold-zoom', ColdZoomImage)
	}
</script>

<style>
	demo-cold-zoom {
		display: block;
		max-width: 240px;
	}

	img {
		width: 100%;
		max-width: 100%;
		height: auto;
	}
</style>
