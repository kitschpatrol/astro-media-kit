---
import Image from 'astro-media-kit/components/Image.astro'
import Picture from 'astro-media-kit/components/Picture.astro'
import Video from 'astro-media-kit/components/Video.astro'
import Zoomer from 'astro-media-kit/components/Zoomer.astro'
import ZoomLink from 'astro-media-kit/components/ZoomLink.astro'
import Layout from '../layouts/Layout.astro'
import { pages } from '../pages'

const { title } = pages.find((p) => p.href === '/zoom')!
const bunnyId = 'f24d7806-2cf5-4df9-a340-840d68eef8c9'
---

<Layout {title}>
	<h1>{title}</h1>

	<h2>1. Single image zoom</h2>
	<p class="note">Click to open lightbox. Each item opens independently.</p>
	<div class="grid">
		<Image alt="JPEG photo" src="../assets/test.jpeg" zoom={true} zoomIndicator />
		<Picture
			alt="SVG tiger"
			formats={['svg']}
			src="../assets/tiger.svg"
			zoom={true}
			zoomIndicator
		/>
	</div>

	<h2>2. Named gallery</h2>
	<p class="note">
		All items share <code>zoom="album"</code>. Click any to open, then swipe between them.
	</p>
	<div class="grid">
		<Picture alt="JPEG photo" src="../assets/test.jpeg" zoom="album" />
		<Image alt="SVG tiger" src="../assets/tiger.svg" zoom="album" />
		<Picture
			alt="Dark mode JPEG"
			src="../assets/test.jpeg"
			srcDark="../assets/test-dark.jpeg"
			zoom="album"
		/>
	</div>

	<h2>3. Mixed media gallery</h2>
	<p class="note">
		Images and videos share <code>zoom="mixed"</code>. Swipe between all media types.
	</p>
	<div class="grid">
		<Picture alt="JPEG photo" src="../assets/test.jpeg" zoom="mixed" zoomLevel="fill">
			Caption for image
		</Picture>
		<Video
			controls="full"
			initialBandwidth={50_000_000}
			src={bunnyId}
			zoom="mixed"
			zoomLevel="fill"
		>
			Caption for the video
		</Video>
		<Image alt="SVG tiger" src="../assets/tiger.svg" zoom="mixed" zoomLevel="fill" />
		<Video
			controls="minimal"
			initialBandwidth={50_000_000}
			src={bunnyId}
			zoom="mixed"
			zoomLevel="fill"
		/>
	</div>

	<h2>4. Scoped galleries</h2>
	<p class="note">
		Both sections use <code>zoom="scoped"</code>, but <code>zoomScope=".gallery-section"</code>
		keeps them separate. Click in one section — you can only swipe within that section.
	</p>
	<div class="gallery-section">
		<h3>Section A</h3>
		<div class="grid">
			<Picture
				alt="JPEG photo"
				src="../assets/test.jpeg"
				zoom="scoped"
				zoomScope=".gallery-section"
			/>
			<Image alt="SVG tiger" src="../assets/tiger.svg" zoom="scoped" zoomScope=".gallery-section" />
		</div>
	</div>
	<div class="gallery-section">
		<h3>Section B</h3>
		<div class="grid">
			<Picture
				alt="Dark mode JPEG"
				src="../assets/test.jpeg"
				srcDark="../assets/test-dark.jpeg"
				zoom="scoped"
				zoomScope=".gallery-section"
			/>
			<Image alt="SVG tiger" src="../assets/tiger.svg" zoom="scoped" zoomScope=".gallery-section" />
		</div>
	</div>

	<h2>5. Standalone with scope</h2>
	<p class="note">
		<code>zoom=&#123;true&#125;</code> with <code>zoomScope=".scope-demo"</code> groups items under
		the same ancestor instead of opening them as standalone lightboxes.
	</p>
	<div class="scope-demo">
		<div class="grid">
			<Picture alt="JPEG photo" src="../assets/test.jpeg" zoom={true} zoomScope=".scope-demo" />
			<Image alt="SVG tiger" src="../assets/tiger.svg" zoom={true} zoomScope=".scope-demo" />
			<Picture
				alt="Dark photo"
				src="../assets/test-dark.jpeg"
				zoom={true}
				zoomScope=".scope-demo"
			/>
		</div>
	</div>

	<h2>6. Arbitrary HTML</h2>
	<p class="note">Zoomer lifts its original content, including ordinary HTML.</p>
	<div class="grid">
		<Zoomer enabled={true}>
			<div style=" aspect-ratio: 3 / 2;padding: 1rem; background: light-dark(#eee, #222);">
				Click to expand this original element.
			</div>
		</Zoomer>
	</div>

	<h2>7. Text links</h2>
	<p class="note">
		A link in prose opens media the page doesn't show: see{' '}
		<ZoomLink src="../assets/test.jpeg" zoom="links">
			this photo
		</ZoomLink>
		, in a gallery with{' '}
		<ZoomLink src={bunnyId} zoom="links">
			this video
		</ZoomLink>
		, or{' '}
		<ZoomLink src="../assets/tiger.svg" zoomLevel="native">
			the tiger
		</ZoomLink>{' '}
		on its own. Without JavaScript each link goes to the file.
	</p>

	<h2>8. Background transitions</h2>
	<p class="note">TK</p>

	<div class="grid">
		<Picture alt="SVG tiger" formats={{ svg: ['svg'] }} src="../assets/tiger.svg" zoom="test" />
		<Picture
			alt="SVG tiger"
			background="red"
			formats={{ svg: ['svg'] }}
			src="../assets/tiger.svg"
			zoom="test"
		/>
		<Picture
			alt="SVG tiger"
			backgroundDark="blue"
			formats={{ svg: ['svg'] }}
			src="../assets/tiger.svg"
			zoom="test"
		/>
		<Picture
			alt="SVG tiger"
			background="red"
			backgroundDark="blue"
			formats={{ svg: ['svg'] }}
			src="../assets/tiger.svg"
			zoom="test"
		/>
	</div>

	<h2 id="zoom-indicators">9. Zoom indicators</h2>
	<p class="note">
		The first section uses the default plus. These examples customize its appearance or replace it
		through the <code>zoom-indicator</code> slot. Hover or use Tab to focus the image: the first
		indicator reverses its colors immediately and fades back when inactive. Reduced motion disables
		the fade. Open an image, then move through the gallery: only the active item's thumbnail
		indicator fades out, and it fades back in when you move to another item or close the lightbox.
	</p>
	<div class="grid">
		<div class="indicator-contrast">
			<Image
				alt="Photo with a black and white zoom indicator"
				src="../assets/test.jpeg"
				zoom="indicators"
				zoomIndicator
			>
				Custom background and active colors.
			</Image>
		</div>
		<div class="indicator-custom">
			<Picture
				alt="Tiger with a custom corner indicator"
				formats={['svg']}
				src="../assets/tiger.svg"
				zoom="indicators"
			>
				<svg
					fill="none"
					slot="zoom-indicator"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
				>
					<path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" />
				</svg>
				A custom slot enables the indicator, positioned at the top left.
			</Picture>
		</div>
		<div class="indicator-disabled">
			<Image
				alt="Photo with its zoom indicator disabled"
				src="../assets/test-dark.jpeg"
				zoom="indicators"
				zoomIndicator={false}
			>
				<svg fill="none" slot="zoom-indicator" stroke="currentColor" viewBox="0 0 24 24">
					<path d="M12 4v16M4 12h16" />
				</svg>
				Explicitly disabled despite the supplied slot. Zoom still works.
			</Image>
		</div>
	</div>
</Layout>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.grid > :global(*) {
		overflow: hidden;
		min-width: 0;
	}

	.grid :global(img) {
		max-width: 100%;
		height: auto;
	}

	.indicator-contrast {
		--amk-zoom-indicator-size: 32px;
		--amk-zoom-indicator-inset: auto 12px 12px auto;
		--amk-zoom-indicator-color: #000;
		--amk-zoom-indicator-background: #fff;
		--amk-zoom-indicator-active-color: #fff;
		--amk-zoom-indicator-active-background: #000;
		--amk-zoom-indicator-opacity: 1;
		--amk-zoom-indicator-active-opacity: 1;
		--amk-zoom-indicator-transition-duration: 250ms;
		--amk-zoom-indicator-active-transition-duration: 0ms;
	}

	.indicator-custom {
		--amk-zoom-indicator-size: 32px;
		--amk-zoom-indicator-inset: 12px auto auto 12px;
		--amk-zoom-indicator-color: #000;
		--amk-zoom-indicator-background: #fff;
	}
</style>
