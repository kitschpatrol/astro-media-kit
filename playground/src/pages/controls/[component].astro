---
import {
	Audio,
	Caption,
	Carousel,
	Image,
	Picture,
	Video,
	Zoomer,
	ZoomLink,
} from 'astro-media-kit/components'
import photoDark from '../../assets/test-dark.jpeg'
import photo from '../../assets/test.jpeg'
import tiger from '../../assets/tiger.svg'
import { demos, readFields, readProps } from '../../controls'
import Layout from '../../layouts/Layout.astro'

export const prerender = false

const slug = Object.keys(demos).find((key) => key === Astro.params.component) as
	keyof typeof demos | undefined
if (slug === undefined) {
	// eslint-disable-next-line unicorn/prefer-module -- Astro frontmatter returns the response for unknown routes.
	return new Response('Component not found', { status: 404 })
}

const demo = demos[slug]
const search = Astro.url.searchParams
const fields = readFields(demo.controls, search)
const {
	zoom: slideZoom,
	zoomLevel: slideZoomLevel,
	...carousel
} = readProps(demos.carousel, search)
---

<Layout title={`${demo.title} prop controls`}>
	<h1>{demo.title} prop controls</h1>
	<p>Change a dropdown to update the preview. The URL keeps your selections.</p>
	<div aria-label="Component prop controls" class="component-links">
		{Object.entries(demos).map(([key, entry]) => (
			<a aria-current={key === slug ? 'page' : undefined} href={`/controls/${key}`}>
				{entry.title}
			</a>
		))}
	</div>
	<form action={`/controls/${slug}`} class="prop-form" method="get">
		<div class="fields">
			{fields.map(({ labels, name, selected }) => (
				<label>
					<span>{name}</span>
					<select name={name}>
						{labels.map((label) => (
							<option selected={label === selected} value={label}>
								{label}
							</option>
						))}
					</select>
				</label>
			))}
		</div>
		<div class="actions">
			<button type="submit">Apply props</button>
			<a href={`/controls/${slug}`}>Reset defaults</a>
		</div>
	</form>
	<h2>Preview</h2>
	<div class="component-preview">
		{slug === 'image' && <Image {...readProps(demos.image, search)}>Sample image caption</Image>}
		{slug === 'picture' && (
			<Picture {...readProps(demos.picture, search)}>Sample picture caption</Picture>
		)}
		{slug === 'video' && <Video {...readProps(demos.video, search)}>Sample video caption</Video>}
		{slug === 'audio' && <Audio {...readProps(demos.audio, search)}>Sample audio caption</Audio>}
		{slug === 'carousel' && (
			<Carousel {...carousel}>
				<Image
					alt="Sample photo"
					src={photo}
					width={640}
					zoom={slideZoom}
					zoomLevel={slideZoomLevel}
				>
					Photo slide
				</Image>
				<Image
					alt="Sample tiger"
					src={tiger}
					width={640}
					zoom={slideZoom}
					zoomLevel={slideZoomLevel}
				>
					Tiger slide
				</Image>
				<Image
					alt="Sample dark photo"
					src={photoDark}
					width={640}
					zoom={slideZoom}
					zoomLevel={slideZoomLevel}
				>
					Dark photo slide
				</Image>
			</Carousel>
		)}
		{slug === 'zoomer' && (
			<Zoomer {...readProps(demos.zoomer, search)}>
				<Image alt="Click to open the sample photo" src={photo} width={640} />
			</Zoomer>
		)}
		{slug === 'zoom-link' && (
			<ZoomLink {...readProps(demos['zoom-link'], search)}>Open sample media</ZoomLink>
		)}
		{slug === 'caption' && (
			<Caption {...readProps(demos.caption, search)}>
				<Image alt="Sample photo with a caption" slot="media-component" src={photo} width={640} />A
				sample caption below the image.
			</Caption>
		)}
	</div>
</Layout>

<script>
	const form = document.querySelector<HTMLFormElement>('.prop-form')
	form?.addEventListener('change', () => {
		form.requestSubmit()
	})
</script>

<style>
	.component-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin-block: 1.5rem;
	}

	.component-links a[aria-current='page'] {
		font-weight: 700;
	}

	.prop-form {
		padding: 1rem;
		border: 1px solid light-dark(#ddd, #444);
		border-radius: 6px;
	}

	.fields {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
		gap: 1rem;
	}

	label {
		display: grid;
		gap: 0.4rem;
		font-size: 0.85rem;
	}

	select,
	button {
		padding: 0.5rem;
		border: 1px solid light-dark(#aaa, #666);
		border-radius: 4px;
		font: inherit;
		color: inherit;
		background: light-dark(#fff, #222);
	}

	select {
		width: 100%;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
		margin-top: 1rem;
		font-size: 0.85rem;
	}

	button {
		cursor: pointer;
	}

	.component-preview {
		max-width: 100%;
	}

	.component-preview :global(img) {
		max-width: 100%;
	}

	.component-preview :global(.outlined) {
		outline: 3px dashed light-dark(#c03, #f68);
		outline-offset: 4px;
	}

	.component-preview :global(figcaption) {
		margin-top: 0.75rem;
		font-size: 0.85rem;
	}
</style>
