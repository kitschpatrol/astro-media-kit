{
	"name": "astro-media-kit-playground",
	"private": true,
	"description": "Astro project playground to evaluate astro-media-kit.",
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"astro": "astro",
		"build": "astro build",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "poptab && astro dev --open",
		"init": "op inject -i .template.env -o .env",
		"preview": "poptab && astro preview --open"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/mdx": "^8.0.2",
		"@types/node": "~24.13.6",
		"astro": "^7.3.5",
		"astro-mdx-kit": "~0.5.1",
		"astro-media-kit": "link:..",
		"poptab": "^1.2.1",
		"sharp": "^0.35.5",
		"shx": "^0.4.0"
	},
	"engines": {
		"node": ">=24.16.0"
	}
}
